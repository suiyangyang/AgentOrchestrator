            <Setter Property="Data" Value="M 5.6,2.2 V 4.2 A 1,1 0 0 1 4.6,5.2 H 2.2 M 11.4,2.2 H 13.4 A 1,1 0 0 1 14.4,3.2 V 5.2 M 14.8,11.4 V 13.4 A 1,1 0 0 1 13.8,14.4 H 11.4 M 5.6,14.8 H 3.6 A 1,1 0 0 1 2.6,13.8 V 11.4" />
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Stroke" Value="#1F2328" />
            <Setter Property="StrokeThickness" Value="1.4" />
