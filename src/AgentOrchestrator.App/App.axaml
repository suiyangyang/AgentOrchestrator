<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AgentOrchestrator.App.App"
             xmlns:local="using:AgentOrchestrator.App"
             xmlns:vm="using:AgentOrchestrator.App.ViewModels"
             xmlns:controls="using:AgentOrchestrator.App.Controls"
             RequestedThemeVariant="Default">
    <!-- Shared width cap for chat content and composer — keeps message columns aligned with input. -->
    <Application.Resources>
        <x:Double x:Key="Chat.Content.MaxWidth">900</x:Double>
        <FontFamily x:Key="UiFontFamily">Segoe UI, Microsoft YaHei UI, Microsoft YaHei</FontFamily>
        <x:Double x:Key="UiFontSize">14</x:Double>
        <FontFamily x:Key="CodeFontFamily">Consolas</FontFamily>
        <x:Double x:Key="CodeFontSize">12</x:Double>
    </Application.Resources>

    <Application.DataTemplates>
        <!-- Explicit DataTemplates: the workspace VMs mapped to their concrete controls. -->
        <DataTemplate DataType="vm:ChatWorkspaceViewModel">
            <controls:ChatWorkspaceControl />
        </DataTemplate>
        <DataTemplate DataType="vm:TaskGraphWorkspaceViewModel">
            <controls:TaskGraphWorkspaceControl />
        </DataTemplate>
        <DataTemplate DataType="vm:TaskOrchestrationWorkspaceViewModel">
            <controls:TaskOrchestrationWorkspaceControl />
        </DataTemplate>
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://AgentOrchestrator.App/Styles/IosTitleBar.axaml" />
        <StyleInclude Source="avares://AgentOrchestrator.App/Styles/IosTitleBar.axaml" />

        <!-- ============================================================ -->
        <!-- Typography tokens                                             -->
        <!--   All values driven by AppSettings.Appearance.*               -->
        <!--   Defaults: UI = Source Han Sans 14px, Code = Consolas 12px. -->
        <!--   Override at runtime via Application.Current.Resources in   -->
        <!--   App.axaml.cs OnFrameworkInitializationCompleted.            -->
        <!--   Source Han Sans is bundled in Assets/Fonts as a single       -->
<!--   variable font (covers all weights incl. SemiBold 600);       -->
<!--   other fonts fall back to system names.                       -->
        <!--   Header/Title chrome and icon glyphs keep hardcoded sizes.   -->
        <!-- ============================================================ -->
        <Style Selector="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource UiFontSize}" />
            <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
        </Style>
        <Style Selector="TextBlock.code-text">
            <Setter Property="FontSize" Value="{DynamicResource CodeFontSize}" />
            <Setter Property="FontFamily" Value="{DynamicResource CodeFontFamily}" />
            <Setter Property="LineHeight" Value="22" />
            <Setter Property="Foreground" Value="#1F2328" />
        </Style>
        <Style Selector="TextBox.tool-code-viewer">
            <Setter Property="FontSize" Value="{DynamicResource CodeFontSize}" />
            <Setter Property="FontFamily" Value="{DynamicResource CodeFontFamily}" />
            <Setter Property="LineHeight" Value="22" />
            <Setter Property="Foreground" Value="#1F2328" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="Border.composer-shell">
            <Setter Property="Background" Value="#FFFFFFFF" />
            <Setter Property="CornerRadius" Value="22" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="BorderBrush" Value="#DCE1E8" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Border.taskgraph-strip">
            <Setter Property="Background" Value="#F8F9FB" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="BorderBrush" Value="#E3E5E9" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Button.taskgraph-strip-button">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#D8DDE5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontSize" Value="{DynamicResource UiFontSize}" />
            <Setter Property="Foreground" Value="#40444B" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.taskgraph-strip-button:pointerover">
            <Setter Property="Background" Value="#F2F4F7" />
            <Setter Property="BorderBrush" Value="#C5C8CE" />
        </Style>
        <Style Selector="Button.taskgraph-strip-button:pressed">
            <Setter Property="Background" Value="#E8EBEF" />
        </Style>
        <Style Selector="Border.queue-item-shell">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="BorderBrush" Value="#E3E5E9" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Border.user-bubble">
            <Setter Property="Background" Value="#F5F6F8" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="10,8" />
        </Style>
        <Style Selector="Border.assistant-loading-dot-shell">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Background" Value="#F3F4F6" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="Border.assistant-loading-dot">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background" Value="#7B8088" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.assistant-loading-text">
            <Setter Property="Foreground" Value="#6E727A" />
            <Setter Property="FontSize" Value="{DynamicResource CodeFontSize}" />
            <Setter Property="FontFamily" Value="{DynamicResource CodeFontFamily}" />
        </Style>
        <Style Selector="Border.inline-attachment">
            <Setter Property="Background" Value="#F7F8FA" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="BorderBrush" Value="#E2E5EA" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Border.image-thumbnail">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="Background" Value="#F0F1F3" />
        </Style>
        <Style Selector="Border.mini-file-icon">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Background" Value="#EEF0F3" />
        </Style>
        <Style Selector="Border.edit-card">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="BorderBrush" Value="#EAECEF" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Border.thought-panel">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Border.popup-shell">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="BorderBrush" Value="#E3E5E9" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BoxShadow" Value="0 6 18 0 #22000000" />
        </Style>
        <Style Selector="Border.question-banner-shell">
            <Setter Property="Background" Value="#F6F8FB" />
            <Setter Property="BorderBrush" Value="#DDE3EA" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <Style Selector="Border.question-banner-card">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="BorderBrush" Value="#DCE2E8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BoxShadow" Value="0 8 20 0 #20000000" />
        </Style>
        <Style Selector="TextBlock.question-banner-title">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#1F2328" />
        </Style>
        <Style Selector="TextBlock.question-banner-subtitle">
            <Setter Property="FontSize" Value="{DynamicResource UiFontSize}" />
            <Setter Property="Foreground" Value="#60656D" />
        </Style>
        <Style Selector="TextBlock.question-item-header">
            <Setter Property="FontSize" Value="{DynamicResource UiFontSize}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#3A4048" />
        </Style>
        <Style Selector="TextBlock.question-item-question">
            <Setter Property="FontSize" Value="{DynamicResource UiFontSize}" />
            <Setter Property="Foreground" Value="#5E646C" />
        </Style>
        <Style Selector="Button.question-option-button">
            <Setter Property="Background" Value="#FAFBFC" />
            <Setter Property="BorderBrush" Value="#E4E8EE" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Button.question-option-button:pointerover">
            <Setter Property="Background" Value="#F1F4F8" />
        </Style>
        <Style Selector="Border.question-option-indicator">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Background" Value="#E7EBF0" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.question-option-label">
            <Setter Property="FontSize" Value="{DynamicResource UiFontSize}" />
            <Setter Property="Foreground" Value="#1F2328" />
        </Style>
        <Style Selector="TextBlock.question-option-description">
            <Setter Property="FontSize" Value="{DynamicResource UiFontSize}" />
            <Setter Property="Foreground" Value="#6C7178" />
        </Style>
        <Style Selector="TextBlock.question-option-indicator-mark">
            <Setter Property="Foreground" Value="#1F2328" />
            <Setter Property="FontSize" Value="{DynamicResource UiFontSize}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.question-banner-status">
            <Setter Property="FontSize" Value="{DynamicResource UiFontSize}" />
            <Setter Property="Foreground" Value="#8B9098" />
        </Style>
        <Style Selector="Button.question-confirm-button">
            <Setter Property="Background" Value="#1F2328" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14,8" />
        </Style>
        <Style Selector="Button.question-banner-close-button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#7B8088" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.question-banner-close-button:pointerover">
            <Setter Property="Background" Value="#EEF1F4" />
            <Setter Property="Foreground" Value="#1F2328" />
        </Style>
        <Style Selector="Border.edit-icon-shell">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="42" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Background" Value="#F3F4F6" />
        </Style>
        <Style Selector="Border.permission-item-icon">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="CornerRadius" Value="17" />
            <Setter Property="Background" Value="#FFF5ED" />
        </Style>
        <Style Selector="Border.permission-icon">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="CornerRadius" Value="13" />
            <Setter Property="Background" Value="#FFF3EA" />
        </Style>
        <Style Selector="Button.toolbar-icon-button">
            <Setter Property="MinWidth" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Width" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.permission-pill">
            <Setter Property="Background" Value="#FFF5ED" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#FFD9BD" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Height" Value="34" />
            <Setter Property="CornerRadius" Value="17" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
        <Style Selector="Button.model-pill">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="Height" Value="30" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.permission-item">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.mini-close-button">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="Button.attachment-close-overlay">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="#1F2328" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="{DynamicResource UiFontSize}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.send-circle-button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="CornerRadius" Value="15" />
            <Setter Property="Background" Value="#1F2328" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.send-circle-button:pointerover">
            <Setter Property="Background" Value="#15181D" />
        </Style>
        <Style Selector="Button.send-circle-button:pressed">
            <Setter Property="Background" Value="#0F1216" />
        </Style>
        <Style Selector="Path.composer-send-icon">
            <Setter Property="Data" Value="M 14 20 L 20 14 L 26 20 M 20 14 L 20 26" />
            <Setter Property="Stroke" Value="White" />
            <Setter Property="StrokeThickness" Value="1.5" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.composer-stop-icon">
            <Setter Property="Width" Value="10" />
            <Setter Property="Height" Value="10" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Background" Value="White" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.queue-item-action">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="Foreground" Value="#8A9099" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.queue-item-action:pointerover">
            <Setter Property="Background" Value="#F2F3F5" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Foreground" Value="#1F2328" />
        </Style>
        <Style Selector="TextBlock.queue-item-icon">
            <Setter Property="Foreground" Value="#A0A6AE" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style Selector="TextBlock.queue-item-text">
            <Setter Property="Foreground" Value="#40444B" />
            <Setter Property="FontSize" Value="{DynamicResource UiFontSize}" />
            <Setter Property="LineHeight" Value="18" />
        </Style>
        <Style Selector="TextBlock.queue-item-action-text">
            <Setter Property="Foreground" Value="#70757D" />
            <Setter Property="FontSize" Value="{DynamicResource UiFontSize}" />
        </Style>
        <Style Selector="ComboBox.permission-combo">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="{DynamicResource UiFontSize}" />
        </Style>
        <Style Selector="ComboBox.permission-combo /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="ComboBox.permission-combo /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style Selector="ComboBox.permission-combo /template/ Panel#PART_DropDownOverlay">
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
        <Style Selector="ComboBox.model-combo">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="{DynamicResource UiFontSize}" />
            <Setter Property="MinHeight" Value="24" />
        </Style>
        <Style Selector="ComboBox.model-combo /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="ComboBox.model-combo /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style Selector="TextBlock.permission-title">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#1F2328" />
        </Style>
        <Style Selector="TextBlock.permission-warning-icon">
            <Setter Property="Foreground" Value="#FF6A00" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="TextBlock.permission-pill-text">
            <Setter Property="Foreground" Value="#FF6A00" />
            <Setter Property="FontSize" Value="{DynamicResource UiFontSize}" />
        </Style>
        <Style Selector="TextBlock.permission-caret">
            <Setter Property="Foreground" Value="#FF6A00" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style Selector="TextBlock.permission-description">
            <Setter Property="Foreground" Value="#9096A0" />
            <Setter Property="FontSize" Value="{DynamicResource UiFontSize}" />
        </Style>
        <Style Selector="TextBlock.assistant-text">
            <Setter Property="FontSize" Value="{DynamicResource UiFontSize}" />
            <Setter Property="LineHeight" Value="18" />
            <Setter Property="Foreground" Value="#1F2328" />
        </Style>
        <Style Selector="TextBlock.thinking-header-text">
            <Setter Property="Foreground" Value="#6E727A" />
			<Setter Property="FontFamily" Value="{DynamicResource CodeFontFamily}" />
            <Setter Property="FontSize" Value="{DynamicResource CodeFontSize}" />
        </Style>
        <Style Selector="TextBlock.thinking-body-text">
            <Setter Property="Foreground" Value="#71757D" />
            <Setter Property="FontSize" Value="{DynamicResource UiFontSize}" />
            <Setter Property="LineHeight" Value="22" />
        </Style>
        <Style Selector="TextBlock.diff-text">
            <Setter Property="Foreground" Value="#18A558" />
            <Setter Property="FontSize" Value="{DynamicResource UiFontSize}" />
        </Style>
        <Style Selector="TextBlock.model-text">
            <Setter Property="Foreground" Value="#40444B" />
            <Setter Property="FontSize" Value="{DynamicResource UiFontSize}" />
        </Style>
        <Style Selector="TextBlock.model-dot">
            <Setter Property="Foreground" Value="#C5C8CE" />
        </Style>
        <Style Selector="TextBlock.model-caret">
            <Setter Property="Foreground" Value="#7B8088" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="FontSize" Value="{DynamicResource UiFontSize}" />
            <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="TextBox:focus">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="FocusAdorner" Value="{x:Null}" />
        </Style>
        <!-- Suppress FluentTheme's blue focus ring on the inner border element. -->
        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <!-- Path-based chevron icons (replaces the ⌄ text character). -->
        <Style Selector="Path.permission-caret">
            <Setter Property="Data" Value="M 0,0 L 4,4 L 8,0" />
            <Setter Property="Stroke" Value="#FF6A00" />
            <Setter Property="StrokeThickness" Value="1.5" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="StrokeJoin" Value="Round" />
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="5" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style Selector="Path.model-caret">
            <Setter Property="Data" Value="M 0,0 L 4,4 L 8,0" />
            <Setter Property="Stroke" Value="#7B8088" />
            <Setter Property="StrokeThickness" Value="1.5" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="StrokeJoin" Value="Round" />
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="5" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <!-- ============================================================ -->
        <!-- Collapsible block (Thinking / Tool call)                      -->
        <!--   Default : transparent, no chrome, no chevron                -->
        <!--   Hover   : light gray pill, chevron visible                   -->
        <!--   Expanded: same pill + content panel below                   -->
        <!-- ============================================================ -->
        <Style Selector="ToggleButton.collapsible-block">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,5" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="#40444B" />
            <Setter Property="FontSize" Value="{DynamicResource UiFontSize}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ToggleButton.collapsible-block:pointerover">
            <Setter Property="Background" Value="#F5F6F8" />
        </Style>
        <Style Selector="ToggleButton.collapsible-block:checked">
            <Setter Property="Background" Value="#F5F6F8" />
        </Style>
        <Style Selector="ToggleButton.collapsible-block /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Path.collapsible-block-chevron">
            <Setter Property="Data" Value="M 0,0 L 4,4 L 8,0" />
            <Setter Property="Stroke" Value="#7B8088" />
