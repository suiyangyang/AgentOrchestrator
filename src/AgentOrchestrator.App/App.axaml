            <Setter Property="Background" Value="#FFF5ED" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>

        <!-- ============================================================ -->
        <!-- TaskGraph toolbar — icon-only buttons                        -->
        <!--   Defaults: 14x14 path. Stroke and thickness match the       -->
        <!--   sidebar's sidebar-nav-icon-path (#7A7F87 / 1.2) so the     -->
        <!--   toolbar visuals stay consistent with the rest of the app.  -->
        <!--   The Button styles in front of each icon control the         -->
        <!--   hit-test area and hover state. Primary / danger overrides  -->
        <!--   below flip the stroke to white / red as needed.             -->
        <!-- ============================================================ -->
        <Style Selector="Path.toolbar-icon-path">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Stroke" Value="#7A7F87" />
            <Setter Property="StrokeThickness" Value="1.2" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="StrokeJoin" Value="Round" />
            <Setter Property="Fill" Value="Transparent" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.task-toolbar-btn:disabled Path.toolbar-icon-path">
            <Setter Property="Opacity" Value="0.4" />
        </Style>
        <!-- Save (floppy) -->
        <Style Selector="Path.toolbar-icon-save">
            <Setter Property="Data" Value="M 2.5,2.5 H 10.5 L 12.5,4.5 V 12.5 H 2.5 Z M 4.5,2.5 V 6.5 H 9.5 V 2.5 M 4.5,9 H 10.5 V 12.5 H 4.5 Z" />
        </Style>
        <!-- Play (execute) -->
        <Style Selector="Path.toolbar-icon-execute">
            <Setter Property="Data" Value="M 3.5,2.5 L 12.5,7.5 L 3.5,12.5 Z" />
            <Setter Property="Fill" Value="#7A7F87" />
        </Style>
        <!-- Chat bubble -->
        <Style Selector="Path.toolbar-icon-chat">
            <Setter Property="Data" Value="M 3,3.5 H 12 A 1.5,1.5 0 0 1 13.5,5 V 9 A 1.5,1.5 0 0 1 12,10.5 H 7.5 L 4.5,13 V 10.5 H 3 A 1.5,1.5 0 0 1 1.5,9 V 5 A 1.5,1.5 0 0 1 3,3.5 Z" />
            <Setter Property="Fill" Value="#7A7F87" />
        </Style>
        <!-- Resume (continue) — two bars then triangle -->
        <Style Selector="Path.toolbar-icon-continue">
            <Setter Property="Data" Value="M 2.5,3.5 H 3.5 V 11.5 H 2.5 Z M 5,3.5 H 6 V 11.5 H 5 Z M 7.5,3 L 12.5,7.5 L 7.5,12 Z" />
        </Style>
        <!-- Retry (refresh arrow) -->
        <Style Selector="Path.toolbar-icon-retry">
            <Setter Property="Data" Value="M 12.5,4.5 A 5,5 0 1 0 12.5,10.5 M 12.5,2 V 4.5 H 10" />
        </Style>
        <!-- Stop (cancel) — square -->
        <Style Selector="Path.toolbar-icon-cancel">
            <Setter Property="Data" Value="M 3.5,3.5 H 11.5 V 11.5 H 3.5 Z" />
            <Setter Property="Fill" Value="#7A7F87" />
        </Style>
        <!-- Plus (add node) -->
        <Style Selector="Path.toolbar-icon-add-node">
            <Setter Property="Data" Value="M 7.5,2.5 V 12.5 M 2.5,7.5 H 12.5" />
        </Style>
        <!-- Trash (delete node) -->
        <Style Selector="Path.toolbar-icon-delete">
            <Setter Property="Data" Value="M 3,4 H 12 M 5,4 V 2.5 H 10 V 4 M 4,4 L 4.5,12.5 H 10.5 L 11,4 M 6.5,6.5 V 11 M 8.5,6.5 V 11" />
        </Style>
        <!-- Auto layout (grid of 4 squares) -->
        <Style Selector="Path.toolbar-icon-auto-layout">
            <Setter Property="Data" Value="M 2.5,2.5 H 6.5 V 6.5 H 2.5 Z M 8.5,2.5 H 12.5 V 6.5 H 8.5 Z M 2.5,8.5 H 6.5 V 12.5 H 2.5 Z M 8.5,8.5 H 12.5 V 12.5 H 8.5 Z" />
        </Style>
        <!-- External link (open execution details) -->
        <Style Selector="Path.toolbar-icon-external-link">
            <Setter Property="Data" Value="M 3,3 H 9 V 4.5 H 4.5 V 11.5 H 11.5 V 7 H 13 V 12.5 A 0.5,0.5 0 0 1 12.5,13 H 3 A 0.5,0.5 0 0 1 2.5,12.5 V 3 A 0.5,0.5 0 0 1 3,2.5 Z M 8,2.5 H 13.5 V 8 M 13,2.5 L 7,8.5" />
            <Setter Property="Stroke" Value="#7B8088" />
            <Setter Property="StrokeThickness" Value="1.2" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="StrokeJoin" Value="Round" />
            <Setter Property="Fill" Value="Transparent" />
        </Style>
        <!-- Zoom in -->
        <Style Selector="Path.toolbar-icon-zoom-in">
            <Setter Property="Data" Value="M 5.5,2.5 A 3.5,3.5 0 1 1 5.5,9.5 A 3.5,3.5 0 1 1 5.5,2.5 Z M 8.5,8.5 L 12.5,12.5 M 5.5,3.5 V 6.5 M 4,5 H 7" />
        </Style>
        <!-- Zoom out -->
        <Style Selector="Path.toolbar-icon-zoom-out">
            <Setter Property="Data" Value="M 5.5,2.5 A 3.5,3.5 0 1 1 5.5,9.5 A 3.5,3.5 0 1 1 5.5,2.5 Z M 8.5,8.5 L 12.5,12.5 M 4,5 H 7" />
        </Style>
        <!-- Reset zoom (1:1) -->
        <Style Selector="Path.toolbar-icon-zoom-reset">
            <Setter Property="Data" Value="M 2.5,4.5 A 3,3 0 1 0 5.5,1.5 V 3.5 M 2.5,3.5 H 4.5 M 7,3.5 H 12.5 V 9 M 12.5,11.5 V 9 M 5,7 H 9.5 A 2.5,2.5 0 0 1 12,9.5 V 12.5 H 5 Z" />
        </Style>
        <!-- Link (chain) -->
        <Style Selector="Path.toolbar-icon-link">
            <Setter Property="Data" Value="M 6,5.5 L 4.5,7 A 2.5,2.5 0 0 0 8,10.5 L 9.5,9 M 9,9.5 L 10.5,8 A 2.5,2.5 0 0 0 7,4.5 L 5.5,6 M 5,9.5 L 10,4.5" />
        </Style>
        <!-- Link broken -->
        <Style Selector="Path.toolbar-icon-link-broken">
            <Setter Property="Data" Value="M 6,5.5 L 4.5,7 A 2.5,2.5 0 0 0 8,10.5 L 9.5,9 M 9,9.5 L 10.5,8 A 2.5,2.5 0 0 0 7,4.5 L 5.5,6 M 5,9.5 L 10,4.5 M 1.5,12.5 L 3.5,11" />
        </Style>
        <!-- More (horizontal ellipsis) -->
        <Style Selector="Path.toolbar-icon-more">
            <Setter Property="Data" Value="M 3.5,7 A 0.9,0.9 0 1 1 3.49,7 M 7.5,7 A 0.9,0.9 0 1 1 7.49,7 M 11.5,7 A 0.9,0.9 0 1 1 11.49,7" />
        </Style>
        <!-- Plus circle (open create dialog) -->
        <Style Selector="Path.toolbar-icon-create">
            <Setter Property="Data" Value="M 7.5,2.5 A 5,5 0 1 1 7.5,12.5 A 5,5 0 1 1 7.5,2.5 Z M 7.5,5 V 10 M 5,7.5 H 10" />
        </Style>
        <!-- Template (stack of layers) -->
        <Style Selector="Path.toolbar-icon-template">
            <Setter Property="Data" Value="M 7.5,2.5 L 12.5,5 L 7.5,7.5 L 2.5,5 Z M 2.5,8 L 7.5,10.5 L 12.5,8 M 2.5,11 L 7.5,13.5 L 12.5,11" />
        </Style>
        <!-- Direct input (pencil) -->
        <Style Selector="Path.toolbar-icon-direct">
            <Setter Property="Data" Value="M 2.5,12.5 L 4,10 L 10,4 L 11.5,5.5 L 5.5,11.5 Z M 8.5,5.5 L 10,4" />
        </Style>
        <!-- Intent (sparkle) -->
        <Style Selector="Path.toolbar-icon-intent">
            <Setter Property="Data" Value="M 7.5,2 L 9,5.5 L 12.5,7 L 9,8.5 L 7.5,12 L 6,8.5 L 2.5,7 L 6,5.5 Z M 11.5,2 L 12,3.5 L 13.5,4 L 12,4.5 L 11.5,6 L 11,4.5 L 9.5,4 L 11,3.5 Z" />
        </Style>
        <!-- Document (file) -->
        <Style Selector="Path.toolbar-icon-document">
            <Setter Property="Data" Value="M 3.5,2.5 H 9 L 12.5,6 V 12.5 H 3.5 Z M 9,2.5 V 6 H 12.5 M 5.5,8 H 10.5 M 5.5,10 H 8.5" />
        </Style>
        <!-- Connection point — small filled circle on the node edge.
             Color comes from per-kind class (port-port-*), size + outline here. -->
        <Style Selector="Ellipse.node-connection-point">
            <Setter Property="Width" Value="11" />
            <Setter Property="Height" Value="11" />
            <Setter Property="Fill" Value="#1F2328" />
            <Setter Property="Stroke" Value="#FFFFFF" />
            <Setter Property="StrokeThickness" Value="2" />
        </Style>
        <Style Selector="Ellipse.node-connection-point:pointerover">
            <Setter Property="StrokeThickness" Value="2.5" />
        </Style>

        <!-- Port colors (per TaskNodeKind) — applied via port-port-* class -->
        <Style Selector="Ellipse.port-circle">
            <Setter Property="Width" Value="11" />
            <Setter Property="Height" Value="11" />
            <Setter Property="Stroke" Value="#FFFFFF" />
            <Setter Property="StrokeThickness" Value="2" />
        </Style>
        <Style Selector="Ellipse.port-circle:pointerover">
            <Setter Property="StrokeThickness" Value="2.5" />
        </Style>
        <Style Selector="Ellipse.port-port-plan">       <Setter Property="Fill" Value="#2459B8" /> </Style>
        <Style Selector="Ellipse.port-port-execute">    <Setter Property="Fill" Value="#FF6A00" /> </Style>
        <Style Selector="Ellipse.port-port-verify">     <Setter Property="Fill" Value="#18A558" /> </Style>
        <Style Selector="Ellipse.port-port-decision">   <Setter Property="Fill" Value="#8B5CF6" /> </Style>
        <Style Selector="Ellipse.port-port-parallel">   <Setter Property="Fill" Value="#06B6D4" /> </Style>
        <Style Selector="Ellipse.port-port-humaninput"> <Setter Property="Fill" Value="#EC4899" /> </Style>

        <!-- Graph node — generic chrome -->
        <Style Selector="Border.graph-node">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#C5C8CE" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12" />
        </Style>
        <Style Selector="Border.graph-node-selected">
            <Setter Property="BorderBrush" Value="#1F2328" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="Border.graph-node-pending">
            <Setter Property="BorderBrush" Value="#FF6A00" />
            <Setter Property="BorderThickness" Value="1.5,1.5,1.5,3" />
            <Setter Property="Background" Value="#FFFCF6" />
        </Style>

        <!-- Bezier (path) edges — colored stroke by source kind.
             Stroke color is set programmatically in code-behind; these
             selectors control thickness and shape defaults. -->
        <Style Selector="Path.graph-edge">
            <Setter Property="StrokeThickness" Value="2" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="Fill" Value="Transparent" />
        </Style>
        <Style Selector="Path.graph-edge-highlighted">
            <Setter Property="StrokeThickness" Value="2.75" />
        </Style>
        <Style Selector="Path.graph-link-preview">
            <Setter Property="StrokeThickness" Value="2" />
            <Setter Property="StrokeDashArray" Value="5,4" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="Fill" Value="Transparent" />
        </Style>

        <!-- ============================================================ -->
        <!-- Mid-edge dot — small circle at the bezier midpoint (t=0.5). -->
        <!--   Default state is a small filled circle in the source's     -->
        <!--   port color with a thin white outline. Hover enlarges it    -->
        <!--   (the size change is driven from code-behind because the    -->
        <!--   hit-test area must grow with the visual; the outline +     -->
        <!--   cursor pseudo-class styles reinforce the affordance here). -->
        <!--   Right-click or Delete removes the edge with no             -->
        <!--   confirmation.                                              -->
        <!-- ============================================================ -->
        <Style Selector="Ellipse.graph-edge-midpoint">
            <Setter Property="Stroke" Value="#FFFFFF" />
            <Setter Property="StrokeThickness" Value="1.5" />
        </Style>
        <Style Selector="Ellipse.graph-edge-midpoint:pointerover">
            <Setter Property="Stroke" Value="#1F2328" />
            <Setter Property="StrokeThickness" Value="2" />
        </Style>

        <!-- Refined node typography -->
        <Style Selector="TextBlock.graph-node-title">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#1F2328" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="TextBlock.graph-node-kind">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.graph-node-description">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#40444B" />
            <Setter Property="LineHeight" Value="15" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="TextBlock.graph-node-output">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="#6E727A" />
            <Setter Property="LineHeight" Value="14" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="TextBlock.graph-node-status">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="#6E727A" />
        </Style>

        <!-- Small pencil edit-button in the lower-left corner of a selected
             node. Only visible when the node is selected but NOT yet editing
             — a single tap selects, double-tap or this button enters edit. -->
        <Style Selector="Button.graph-node-edit-button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style Selector="Button.graph-node-edit-button:pointerover">
            <Setter Property="Background" Value="#E8EBF0" />
        </Style>
        <Style Selector="Path.graph-node-edit-button-icon">
            <Setter Property="Data" Value="M 12.5,4.5 L 14,3 L 12.5,1.5 L 11,3 Z M 3,13 L 10.5,5.5 L 11,6 L 3.5,13.5 Z M 2,13.5 L 4,13.5 L 2,15.5 Z" />
            <Setter Property="Stroke" Value="#7A7F87" />
            <Setter Property="StrokeThickness" Value="1.2" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="StrokeJoin" Value="Round" />
            <Setter Property="Fill" Value="Transparent" />
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.graph-link-preview-target">
            <Setter Property="Background" Value="#1A2459B8" />
            <Setter Property="BorderBrush" Value="#2459B8" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <!-- ============================================================ -->
        <!-- Resize grip — bottom-right corner of a selected node          -->
        <!--   iPad OS-style quarter-circle arc drawn inside a 18×18       -->
        <!--   hit-target Border so it can be hover-detected and easily    -->
        <!--   reached even on default-sized nodes. The cursor is set in   -->
        <!--   code (BottomRightCorner) so it appears immediately on       -->
        <!--   hover. The grip is visible while the node is selected or    -->
        <!--   being edited. Per design: no background in any state, the   -->
        <!--   arc thickens on hover, and the curve mirrors the node's     -->
        <!--   bottom-right corner radius but is inset so it sits cleanly  -->
        <!--   inside the card edge.                                       -->
        <!-- ============================================================ -->
        <Style Selector="Border.graph-node-resize-grip">
            <!-- Transparent background in all states. The grip is a
                 hit-target, not a fillable button — the visible affordance
                 is the arc inside the icon only. -->
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="IsHitTestVisible" Value="True" />
        </Style>
        <Style Selector="Border.graph-node-resize-grip:pointerover">
            <!-- Still transparent — hover thickens the arc stroke, not the
                 background. -->
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border.graph-node-resize-grip:pressed">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Path.graph-node-resize-grip-icon">
            <!-- Quarter-circle arc from (15,3) to (3,15) with radius 12,
                 sweep=1 (clockwise in screen coords, so the arc bows
                 toward the lower-right corner of the grip, matching the
                 node's bottom-right corner radius). The arc sits inside
                 an 18×18 grip container, reading as a clear resize
                 handle just inside the node edge. -->
            <Setter Property="Data" Value="M 15,3 A 12,12 0 0 1 3,15" />
            <Setter Property="Stroke" Value="#5A6068" />
            <Setter Property="StrokeThickness" Value="2" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="Fill" Value="Transparent" />
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.graph-node-resize-grip:pointerover Path.graph-node-resize-grip-icon">
            <!-- Hover: the arc thickens to make the affordance feel
                 "armed". Stroke gets darker at the same time so the
                 thicker line is more visible on the white card. -->
            <Setter Property="Stroke" Value="#1F2328" />
            <Setter Property="StrokeThickness" Value="2.8" />
        </Style>
        <Style Selector="Border.graph-node-resize-grip:pressed Path.graph-node-resize-grip-icon">
            <Setter Property="Stroke" Value="#1F2328" />
            <Setter Property="StrokeThickness" Value="2.8" />
        </Style>

        <!-- ============================================================ -->
        <!-- Inline editing controls — visible only when a node is        -->
        <!--   being edited (double-tap or pencil button). The inputs     -->
        <!--   visually replace the read-only text without growing the    -->
        <!--   node — no borders, transparent background, compact sizes.  -->
        <!-- ============================================================ -->
        <Style Selector="TextBox.graph-node-edit-title">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#1F2328" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0,2,0,0" />
        </Style>
        <Style Selector="TextBox.graph-node-edit-title:focus">
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="TextBox.graph-node-edit-title /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="TextBox.graph-node-edit-title:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="#F5F9FF" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="#2459B8" />
        </Style>

        <Style Selector="ComboBox.graph-node-edit-kind">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style Selector="ComboBox.graph-node-edit-kind /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style Selector="TextBox.graph-node-edit-description">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#40444B" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0,2" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBox.graph-node-edit-description:focus">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="TextBox.graph-node-edit-description /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="TextBox.graph-node-edit-description:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="#F5F9FF" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="#2459B8" />
        </Style>

        <!-- ============================================================ -->
        <!-- Icon-only task-toolbar buttons                                -->
        <!--   Used in the TaskGraph control's main toolbar.               -->
        <!--   Hit-test box: 32×32, icon centered, 14×14.                  -->
        <!-- ============================================================ -->
        <Style Selector="Button.task-toolbar-btn">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#DCE1E8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#1F2328" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.task-toolbar-btn:pointerover">
            <Setter Property="Background" Value="#F3F4F6" />
            <Setter Property="BorderBrush" Value="#C5C8CE" />
        </Style>
        <Style Selector="Button.task-toolbar-btn:pressed">
            <Setter Property="Background" Value="#E8E9EB" />
        </Style>
        <Style Selector="Button.task-toolbar-btn-primary">
            <Setter Property="Background" Value="#1F2328" />
            <Setter Property="BorderBrush" Value="#1F2328" />
        </Style>
        <Style Selector="Button.task-toolbar-btn-primary:pointerover">
            <Setter Property="Background" Value="#15181D" />
            <Setter Property="BorderBrush" Value="#15181D" />
        </Style>
        <Style Selector="Button.task-toolbar-btn-primary:pressed">
            <Setter Property="Background" Value="#0F1216" />
            <Setter Property="BorderBrush" Value="#0F1216" />
        </Style>
        <Style Selector="Button.task-toolbar-btn-primary Path.toolbar-icon-path">
            <Setter Property="Stroke" Value="#FFFFFF" />
            <Setter Property="Fill" Value="Transparent" />
        </Style>
        <Style Selector="Button.task-toolbar-btn-primary Path.toolbar-icon-execute">
            <Setter Property="Fill" Value="#FFFFFF" />
        </Style>
        <Style Selector="Button.task-toolbar-btn-danger">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#F2C5C5" />
        </Style>
        <Style Selector="Button.task-toolbar-btn-danger:pointerover">
            <Setter Property="Background" Value="#FFF5F5" />
            <Setter Property="BorderBrush" Value="#E99A9A" />
        </Style>
        <Style Selector="Button.task-toolbar-btn-danger Path.toolbar-icon-path">
            <Setter Property="Stroke" Value="#C53B27" />
        </Style>
        <!-- Cancel icon is fill-based (solid square); mirror the danger stroke. -->
        <Style Selector="Button.task-toolbar-btn-danger Path.toolbar-icon-cancel">
            <Setter Property="Fill" Value="#C53B27" />
        </Style>
        <Style Selector="Button.task-toolbar-btn-danger Path.toolbar-icon-execute">
            <Setter Property="Fill" Value="#C53B27" />
        </Style>

        <!-- ============================================================ -->
        <!-- Creation dialog (popup)                                       -->
        <!--   Card: white background, 16px corner radius, 960x820 max.    -->
        <!--   Used for the "Create from template/direct/intent/document"  -->
        <!--   flow so it doesn't eat a big chunk of the workspace.        -->
        <!-- ============================================================ -->
        <Style Selector="Border.create-dialog-backdrop">
            <Setter Property="Background" Value="#66000000" />
        </Style>
        <Style Selector="Border.create-dialog-card">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="BorderBrush" Value="#E3E5E9" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BoxShadow" Value="0 12 32 0 #40000000" />
            <Setter Property="MinWidth" Value="760" />
            <Setter Property="MaxWidth" Value="960" />
            <Setter Property="MinHeight" Value="540" />
            <Setter Property="MaxHeight" Value="820" />
        </Style>
        <Style Selector="TextBlock.create-dialog-title">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#1F2328" />
        </Style>
        <Style Selector="TextBlock.create-dialog-subtitle">
            <Setter Property="FontSize" Value="{DynamicResource UiFontSize}" />
            <Setter Property="Foreground" Value="#6E727A" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="Button.create-dialog-mode">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#DCE1E8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.create-dialog-mode:pointerover">
            <Setter Property="Background" Value="#F3F4F6" />
            <Setter Property="BorderBrush" Value="#C5C8CE" />
        </Style>
        <Style Selector="Button.create-dialog-mode:checked">
            <Setter Property="Background" Value="#1F2328" />
            <Setter Property="BorderBrush" Value="#1F2328" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
        <Style Selector="Button.create-dialog-mode:checked Path.toolbar-icon-path">
            <Setter Property="Stroke" Value="#FFFFFF" />
        </Style>
        <Style Selector="Button.create-dialog-mode:checked Path.toolbar-icon-execute">
            <Setter Property="Fill" Value="#FFFFFF" />
        </Style>
        <Style Selector="Border.create-dialog-body">
            <Setter Property="Background" Value="#F3F4F6" />
            <Setter Property="BorderBrush" Value="#DCE1E8" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style Selector="Button.create-dialog-primary">
            <Setter Property="Background" Value="#1F2328" />
            <Setter Property="BorderBrush" Value="#1F2328" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="{DynamicResource UiFontSize}" />
            <Setter Property="Padding" Value="20,8" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="MinWidth" Value="88" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.create-dialog-primary:pointerover">
            <Setter Property="Background" Value="#000000" />
            <Setter Property="BorderBrush" Value="#000000" />
        </Style>
        <Style Selector="Button.create-dialog-secondary">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#DCE1E8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#1F2328" />
            <Setter Property="FontSize" Value="{DynamicResource UiFontSize}" />
            <Setter Property="Padding" Value="20,8" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="MinWidth" Value="88" />
        </Style>
        <Style Selector="Button.create-dialog-secondary:pointerover">
            <Setter Property="Background" Value="#F5F6F8" />
            <Setter Property="BorderBrush" Value="#C5C8CE" />
        </Style>
        <!-- Visible input controls for the create dialog body.             -->
        <!-- Overrides the global transparent TextBox style so inputs       -->
        <!-- are clearly distinguishable from background in form context.    -->
        <Style Selector="TextBox.create-dialog-input">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#DCE1E8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="FontSize" Value="{DynamicResource UiFontSize}" />
            <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
        </Style>
        <Style Selector="TextBox.create-dialog-input:focus">
            <Setter Property="BorderBrush" Value="#1F2328" />
            <Setter Property="BorderThickness" Value="1.5" />
        </Style>
        <!-- Suppress FluentTheme's blue focus ring on the inner border.    -->
        <Style Selector="TextBox.create-dialog-input:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <!-- ComboBox uses the same visible style.                          -->
        <Style Selector="ComboBox.create-dialog-input">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#DCE1E8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,8" />
        </Style>

        <!-- ============================================================ -->
        <!-- "More" popup menu items                                       -->
        <!-- ============================================================ -->
        <Style Selector="Button.more-popup-item">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="#1F2328" />
            <Setter Property="FontSize" Value="{DynamicResource UiFontSize}" />
        </Style>
        <Style Selector="Button.more-popup-item:pointerover">
            <Setter Property="Background" Value="#F3F4F6" />
        </Style>
        <Style Selector="Button.more-popup-item:disabled">
            <Setter Property="Opacity" Value="0.5" />
        </Style>

        <!-- ============================================================ -->
        <!-- Agent error banner — red-tinted bar below the title bar      -->
        <!-- ============================================================ -->
        <Style Selector="Border.agent-error-banner">
            <Setter Property="Background" Value="#FEF1F1" />
            <Setter Property="BorderBrush" Value="#F5C6C6" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="12,8" />
        </Style>
        <Style Selector="TextBlock.agent-error-banner-text">
            <Setter Property="Foreground" Value="#B42318" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="Button.agent-error-banner-close">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#B42318" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.agent-error-banner-close:pointerover">
            <Setter Property="Background" Value="#FDEDED" />
        </Style>
        <Style Selector="Button.agent-error-banner-copy">
            <Setter Property="Background" Value="#FFF6F6" />
            <Setter Property="MinWidth" Value="44" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="BorderBrush" Value="#F3B2B2" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Foreground" Value="#B42318" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.agent-error-banner-copy:pointerover">
            <Setter Property="Background" Value="#FDEDED" />
        </Style>
        <Style Selector="Button.title-bar-btn-active">
            <Setter Property="Background" Value="#EEF3FB" />
            <Setter Property="BorderBrush" Value="#BFD1F3" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Button.title-bar-btn-active Path.workspace-orchestrator-toggle-icon">
            <Setter Property="Stroke" Value="#2459B8" />
            <Setter Property="Fill" Value="Transparent" />
        </Style>
        <Style Selector="Ellipse.agent-error-banner-dot">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="Fill" Value="#D92D20" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>

        <!-- ============================================================ -->
        <!-- Task Orchestration Workspace styles                           -->
        <!-- ============================================================ -->

        <!-- Quick action button (新任务图 / 搜索) in top nav. -->
        <Style Selector="Button.orch-quick-action">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#DCE1E8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="MinHeight" Value="36" />
        </Style>
        <Style Selector="Button.orch-quick-action:pointerover">
            <Setter Property="Background" Value="#F5F6F8" />
            <Setter Property="BorderBrush" Value="#C5C8CE" />
        </Style>

        <!-- Search TextBox in top nav. -->
        <Style Selector="TextBox.orch-search-input">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#DCE1E8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="FontSize" Value="{DynamicResource UiFontSize}" />
            <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBox.orch-search-input:focus">
            <Setter Property="BorderBrush" Value="#1F2328" />
        </Style>

        <!-- Inline edit TextBox inside template row. -->
        <Style Selector="TextBox.orch-inline-edit">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#2F7CF6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="FontSize" Value="{DynamicResource UiFontSize}" />
            <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
        </Style>

        <!-- Right-pane detail card wrapper. -->
        <Style Selector="Border.orch-detail-card">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E2E5EA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <!-- Detail card title. -->
        <Style Selector="TextBlock.orch-detail-title">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#1F2328" />
        </Style>

        <!-- Detail card meta label. -->
        <Style Selector="TextBlock.orch-detail-meta">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#6E727A" />
        </Style>

        <!-- Status pill (for task graph execution state). -->
        <Style Selector="Border.orch-status-pill">
            <Setter Property="Background" Value="#F3F4F6" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="MinHeight" Value="22" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>

        <!-- Primary action button (black bg, white text). -->
        <Style Selector="Button.orch-primary-btn">
            <Setter Property="Background" Value="#1F2328" />
            <Setter Property="BorderBrush" Value="#1F2328" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="{DynamicResource UiFontSize}" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.orch-primary-btn:pointerover">
            <Setter Property="Background" Value="#000000" />
            <Setter Property="BorderBrush" Value="#000000" />
        </Style>

        <!-- Secondary action button (white bg, border). -->
        <Style Selector="Button.orch-secondary-btn">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#DCE1E8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#1F2328" />
            <Setter Property="FontSize" Value="{DynamicResource UiFontSize}" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="Button.orch-secondary-btn:pointerover">
            <Setter Property="Background" Value="#F5F6F8" />
            <Setter Property="BorderBrush" Value="#C5C8CE" />
        </Style>

        <!-- Detail input (TextBox in right pane). -->
        <Style Selector="TextBox.orch-detail-input">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#DCE1E8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="FontSize" Value="{DynamicResource UiFontSize}" />
            <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
        </Style>
        <Style Selector="TextBox.orch-detail-input:focus">
            <Setter Property="BorderBrush" Value="#1F2328" />
            <Setter Property="BorderThickness" Value="1.5" />
        </Style>
        <Style Selector="TextBox.orch-detail-input:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <!-- Detail ComboBox — same look as TextBox. -->
        <Style Selector="ComboBox.orch-detail-input">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#DCE1E8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,8" />
        </Style>

        <!-- Empty state hint. -->
        <Style Selector="Border.orch-empty-hint">
            <Setter Property="Background" Value="#F7F8FA" />
            <Setter Property="BorderBrush" Value="#E2E5EA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="24,32" />
            <Setter Property="MinWidth" Value="280" />
        </Style>
    </Application.Styles>
</Application>



