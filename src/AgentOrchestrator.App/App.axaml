        <!-- TaskGraph top-bar title + fullscreen icons -->
        <Style Selector="Path.graph-editor-title-icon">
            <!-- Stylized DAG glyph: one root node connected to two children via a T-junction.
                 Inherits visual defaults from the icon-path family above. -->
            <Setter Property="Data" Value="M 7,1.5 A 1.2,1.2 0 1 1 4.6,1.5 A 1.2,1.2 0 1 1 7,1.5 Z M 5.8,2.7 L 2.5,7 M 5.8,2.7 L 5.8,7 M 5.8,2.7 L 9.1,7 M 3.4,8.6 A 1.2,1.2 0 1 1 1,8.6 A 1.2,1.2 0 1 1 3.4,8.6 Z M 6.6,8.6 A 1.2,1.2 0 1 1 4.2,8.6 A 1.2,1.2 0 1 1 6.6,8.6 Z M 9.8,8.6 A 1.2,1.2 0 1 1 7.4,8.6 A 1.2,1.2 0 1 1 9.8,8.6 Z M 1.9,11.4 A 1.2,1.2 0 1 1 -0.5,11.4 A 1.2,1.2 0 1 1 1.9,11.4 Z M 8.3,11.4 A 1.2,1.2 0 1 1 5.9,11.4 A 1.2,1.2 0 1 1 8.3,11.4 Z M 14.5,11.4 A 1.2,1.2 0 1 1 12.1,11.4 A 1.2,1.2 0 1 1 14.5,11.4 Z M 2.7,9.8 L 1.9,11.4 M 5.8,9.8 L 5.8,11.4 M 8.7,9.8 L 8.3,11.4 M 11.5,9.8 L 14.5,11.4" />
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Stroke" Value="#1F2328" />
            <Setter Property="StrokeThickness" Value="1.1" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="StrokeJoin" Value="Round" />
            <Setter Property="Fill" Value="Transparent" />
        </Style>
        <Style Selector="Path.graph-fullscreen-enter-icon">
            <!-- Four corner brackets pointing outward (enter fullscreen). -->
            <Setter Property="Data" Value="M 2.2,5.6 V 2.6 A 0.4,0.4 0 0 1 2.6,2.2 H 5.6 M 11.4,2.2 H 14.4 A 0.4,0.4 0 0 1 14.8,2.6 V 5.6 M 14.8,11.4 V 14.4 A 0.4,0.4 0 0 1 14.4,14.8 H 11.4 M 5.6,14.8 H 2.6 A 0.4,0.4 0 0 1 2.2,14.4 V 11.4" />
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Stroke" Value="#1F2328" />
            <Setter Property="StrokeThickness" Value="1.4" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="StrokeJoin" Value="Round" />
            <Setter Property="Fill" Value="Transparent" />
        </Style>
        <Style Selector="Path.graph-fullscreen-exit-icon">
