<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AgentOrchestrator.App.ViewModels"
        xmlns:controls="using:AgentOrchestrator.App.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1100"
        d:DesignHeight="820"
        x:Class="AgentOrchestrator.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Agent Orchestrator"
        Width="1100" Height="820"
        MinWidth="900" MinHeight="600"
        ExtendClientAreaToDecorationsHint="True"
        WindowDecorations="BorderOnly"
        ExtendClientAreaTitleBarHeightHint="-1"
        Background="#F5F5F7">

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*">
        <!-- Title Bar (drag-to-move via PointerPressed + BeginMoveDrag) -->
        <Border Grid.Row="0" Classes="custom-title-bar"
                PointerPressed="OnTitleBarPointerPressed"
                DoubleTapped="OnTitleBarDoubleTapped">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- Left: Icon + Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                    <Button Classes="title-bar-btn" Click="OnSidebarToggleButtonClick"
                            ToolTip.Tip="显示/隐藏左侧边栏"
                            Content="&#xE700;" />
                </StackPanel>

                <!-- Right: Settings + Window Controls (Segoe MDL2 Assets glyphs) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="0">
                    <!-- Settings (gear icon: &#xE115;) -->
                    <Button Classes="title-bar-btn" Click="OnSettingsButtonClick" ToolTip.Tip="设置"
                            Content="&#xE115;" />
                    <!-- Minimize (dash: &#xE921;) -->
                    <Button Classes="title-bar-btn" Click="OnMinButtonClick" ToolTip.Tip="最小化"
                            Content="&#xE921;" />
                    <!-- Maximize / Restore (&#xE922; ↔ &#xE923;) -->
                    <Button x:Name="MaxButton" Classes="title-bar-btn" Click="OnMaxButtonClick" ToolTip.Tip="最大化"
                            Content="&#xE922;" />
                    <!-- Close (X: &#xE8BB;) -->
                    <Button Classes="title-bar-btn title-bar-btn-close" Click="OnCloseButtonClick" ToolTip.Tip="关闭"
                            Content="&#xE8BB;" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content: 3 columns (Sidebar | Chat/Workspace | Right Sidebar) -->
        <Grid Grid.Row="1" RowDefinitions="Auto,*">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding LeftSidebarWidth}" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="{Binding RightSidebarWidth}" />
            </Grid.ColumnDefinitions>

            <Border Grid.RowSpan="2" Grid.Column="0" IsVisible="{Binding IsLeftSidebarVisible}">
                <controls:SidebarControl DataContext="{Binding Sidebar}" />
            </Border>

            <Border Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Classes="workspace-header">
                <Grid ColumnDefinitions="*,Auto,Auto">
                    <TextBlock Grid.Column="0"
                               Text="{Binding ActiveWorkspaceTitle}"
                               Classes="workspace-header-title"
                               TextTrimming="CharacterEllipsis" />
                    <ToggleButton Grid.Column="1"
                                  Classes="workspace-header-action task-orchestration-toggle"
                                  ToolTip.Tip="显示/隐藏任务编排"
                                  IsChecked="{Binding IsTaskOrchestrationVisible, Mode=TwoWay}"
                                  Content="编"
                                  Margin="0,0,8,0" />
                    <Button Grid.Column="2"
                            Classes="workspace-header-action"
                            Click="OnRightSidebarToggleButtonClick"
                            ToolTip.Tip="显示/隐藏右侧边栏"
                            Content="&#xE8A7;" />
                </Grid>
            </Border>

            <ContentControl Grid.Row="1" Grid.Column="1" Content="{Binding ActiveWorkspace}" />

            <Grid Grid.Row="1" Grid.Column="2" Background="#FBFBFC" IsVisible="{Binding IsRightSidebarVisible}">
                <Border BorderBrush="#E2E5EA" BorderThickness="1,0,0,0" />
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="16,16,24,16" Spacing="14">
                        <StackPanel Spacing="10"
                                    IsVisible="{Binding IsTaskOrchestrationVisible}">
                            <TextBlock Text="任务编排"
                                       Classes="right-panel-title" />

                            <Border Classes="right-panel-placeholder">
                                <TextBlock Text="占位中"
                                           Classes="right-panel-placeholder-text"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>

                        <TextBlock Text="Subagent"
                                   Classes="right-panel-section-title" />

                        <ItemsControl ItemsSource="{Binding Chat.SubagentActivities}"
                                      IsVisible="{Binding Chat.HasSubagentActivities}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:SubagentActivityViewModel">
                                    <controls:SubagentActivityCardControl />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="当前对话还没有 subagent 消息"
                                   Classes="right-panel-empty"
                                   IsVisible="{Binding !Chat.HasSubagentActivities}" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <GridSplitter Grid.RowSpan="2"
                          Grid.Column="0"
                          Width="4"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Stretch"
                          Background="Transparent"
                          ShowsPreview="True" />
            <GridSplitter Grid.RowSpan="2"
                          Grid.Column="2"
                          Width="4"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Stretch"
                          Background="Transparent"
                          ShowsPreview="True" />
        </Grid>

        <Grid Grid.Row="1"
              Background="#66000000"
              IsVisible="{Binding Sidebar.IsSearchOverlayVisible}"
              PointerPressed="OnSearchOverlayPointerPressed">
            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="620"
                    Padding="16"
                    CornerRadius="18"
                    Background="#FFFFFFFF"
                    BorderBrush="#E3E5E9"
                    BorderThickness="1">
                <Grid RowDefinitions="Auto,Auto,*" ColumnDefinitions="*">
                    <TextBox x:Name="SearchBox"
                             Grid.Row="0"
                             PlaceholderText="搜索对话"
                             Text="{Binding Sidebar.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="14"
                             Margin="0,0,0,12" />
                    <TextBlock Grid.Row="1"
                               Text="近期对话"
                               FontSize="12"
                               Foreground="#9096A0"
                               Margin="2,0,0,8" />
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" MaxHeight="420">
                        <ItemsControl ItemsSource="{Binding Sidebar.SearchResults}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:SidebarSessionViewModel">
                                    <Button Classes="search-result-row"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch"
                                            Click="OnSearchResultClick"
                                            CommandParameter="{Binding SessionId}">
                                        <Grid ColumnDefinitions="Auto,*,Auto" Margin="8,6">
                                            <TextBlock Grid.Column="0"
                                                       Text="◌"
                                                       Foreground="#7B8088"
                                                       Margin="0,0,10,0" />
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock Text="{Binding Title}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="#1F2328" />
                                                <TextBlock Text="{Binding DisplayRelativeTime}"
                                                           FontSize="11"
                                                           Foreground="#9096A0" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding ProjectId}"
                                                       FontSize="11"
                                                       Foreground="#C5C8CE"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
