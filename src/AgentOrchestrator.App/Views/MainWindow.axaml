<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AgentOrchestrator.App.ViewModels"
        xmlns:controls="using:AgentOrchestrator.App.Controls"
        xmlns:chat="using:AgentOrchestrator.App.Models.Chat"
        xmlns:conv="using:Avalonia.Data.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1100"
        d:DesignHeight="820"
        x:Class="AgentOrchestrator.App.Views.MainWindow"
        x:Name="Root"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Agent Orchestrator"
        Width="1300" Height="800"
        MinWidth="900" MinHeight="600"
        ExtendClientAreaToDecorationsHint="True"
        WindowDecorations="BorderOnly"
        ExtendClientAreaTitleBarHeightHint="-1"
        Background="#F5F5F7">

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*">
        <!-- Title Bar (drag-to-move via PointerPressed + BeginMoveDrag) -->
        <Border Grid.Row="0" Classes="custom-title-bar"
                PointerPressed="OnTitleBarPointerPressed"
                DoubleTapped="OnTitleBarDoubleTapped">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- Left: Icon + Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                    <Button Classes="title-bar-btn title-bar-outline-btn"
                            Click="OnSidebarToggleButtonClick"
                            ToolTip.Tip="显示/隐藏左侧边栏">
                        <Grid Width="14" Height="14">
                            <Border Classes="title-bar-outline-icon-box" />
                            <Border Classes="title-bar-outline-icon-divider-left" />
                        </Grid>
                    </Button>
                </StackPanel>

                <!-- Right: Settings + Window Controls (Segoe MDL2 Assets glyphs) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="0">
                    <Button Classes="title-bar-btn title-bar-service-btn"
                            Click="OnServicesButtonClick"
                            ToolTip.Tip="服务">
                        <Grid Width="32" Height="30"
                              ClipToBounds="False">
                            <Path Classes="title-bar-service-icon"
                                  Data="M4.5,4.75 H11.5 A1.25,1.25 0 0 1 12.75,6 V8 A1.25,1.25 0 0 1 11.5,9.25 H4.5 A1.25,1.25 0 0 1 3.25,8 V6 A1.25,1.25 0 0 1 4.5,4.75 Z M6.25,6.5 A0.75,0.75 0 1 0 6.25,8 A0.75,0.75 0 0 0 6.25,6.5 Z M4.5,10.75 H11.5 A1.25,1.25 0 0 1 12.75,12 V14 A1.25,1.25 0 0 1 11.5,15.25 H4.5 A1.25,1.25 0 0 1 3.25,14 V12 A1.25,1.25 0 0 1 4.5,10.75 Z M6.25,12.5 A0.75,0.75 0 1 0 6.25,14 A0.75,0.75 0 0 0 6.25,12.5 Z M15.75,7.25 H18.5 A1.25,1.25 0 0 1 19.75,8.5 V11.5 A1.25,1.25 0 0 1 18.5,12.75 H15.75 V14.25 A0.75,0.75 0 0 1 14.25,14.25 V5.75 A0.75,0.75 0 0 1 15.75,5.75 Z M16.25,8.75 V11.25 H18.25 V8.75 Z" />

                            <Border Classes="title-bar-service-badge"
                                    IsVisible="{Binding HasConnectedServices}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top">
                                <TextBlock Text="{Binding ConnectedServiceCount}"
                                           Classes="title-bar-service-badge-text" />
                            </Border>
                        </Grid>
                    </Button>
                    <Button Classes="title-bar-btn" Click="OnSettingsButtonClick" ToolTip.Tip="设置">
                        <Path Classes="workspace-header-icon window-settings-icon" />
                    </Button>
                    <Button Classes="title-bar-btn" Click="OnMinButtonClick" ToolTip.Tip="最小化">
                        <Path Classes="workspace-header-icon window-minimize-icon" />
                    </Button>
                    <Button x:Name="MaxButton" Classes="title-bar-btn" Click="OnMaxButtonClick" ToolTip.Tip="最大化">
                        <Path Classes="workspace-header-icon window-maximize-icon" />
                    </Button>
                    <Button Classes="title-bar-btn title-bar-btn-close" Click="OnCloseButtonClick" ToolTip.Tip="关闭">
                        <Path Classes="workspace-header-icon window-close-icon" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content: 3 columns (Sidebar | Chat/Workspace | Right Sidebar) -->
        <Grid Grid.Row="1" RowDefinitions="Auto,*">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding LeftSidebarWidth}" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="{Binding RightSidebarWidth}" />
            </Grid.ColumnDefinitions>

            <Border Grid.RowSpan="2" Grid.Column="0" IsVisible="{Binding IsLeftSidebarVisible}">
                <controls:SidebarControl DataContext="{Binding Sidebar}" />
            </Border>

                        <Border x:Name="WorkspaceHeaderBar" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Classes="workspace-header">
                <Grid ColumnDefinitions="*,Auto,Auto">
                                        <Grid Grid.Column="0"
                                                    ColumnDefinitions="Auto,Auto,*"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center">
                                                <TextBlock Grid.Column="0"
                                                                     Text="{Binding ActiveWorkspaceTitle}"
                                                                     Classes="workspace-header-title"
                                                                     TextTrimming="CharacterEllipsis" />
                                                <Path Grid.Column="1"
                                                            Classes="workspace-header-chevron"
                                                            Margin="8,0,0,0"
                                                            IsVisible="{Binding #WorkspaceHeaderBar.IsPointerOver}" />
                                        </Grid>
                    <ToggleButton Grid.Column="1"
                                  Classes="workspace-header-action task-orchestration-toggle"
                                  ToolTip.Tip="显示/隐藏任务编排"
                                  IsChecked="{Binding IsTaskOrchestrationVisible, Mode=TwoWay}"
                                  Margin="0,0,8,0">
                        <Path Classes="workspace-header-icon workspace-orchestrator-toggle-icon" />
                    </ToggleButton>
                    <Button Grid.Column="2"
                            Classes="workspace-header-action workspace-header-outline-action"
                            Click="OnRightSidebarToggleButtonClick"
                            ToolTip.Tip="显示/隐藏右侧边栏">
                        <Path Classes="workspace-header-icon workspace-layout-icon" />
                    </Button>
                </Grid>
            </Border>

            <ContentControl Grid.Row="1" Grid.Column="1" Content="{Binding ActiveWorkspace}" />

            <Grid Grid.Row="1" Grid.Column="2" Background="#FBFBFC" IsVisible="{Binding IsRightSidebarVisible}">
                <Border BorderBrush="#E2E5EA" BorderThickness="1,0,0,0" />
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="16,16,24,16" Spacing="14">
                        <StackPanel Spacing="10"
                                    IsVisible="{Binding IsTaskOrchestrationVisible}">
                            <TextBlock Text="任务编排"
                                       Classes="right-panel-title" />

                            <Border Classes="right-panel-placeholder">
                                <TextBlock Text="占位中"
                                           Classes="right-panel-placeholder-text"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>

                        <TextBlock Text="Subagent"
                                   Classes="right-panel-section-title" />

                        <ItemsControl ItemsSource="{Binding Chat.SubagentActivities}"
                                      IsVisible="{Binding Chat.HasSubagentActivities}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:SubagentActivityViewModel">
                                    <controls:SubagentActivityCardControl />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="当前对话还没有 subagent 消息"
                                   Classes="right-panel-empty"
                                   IsVisible="{Binding !Chat.HasSubagentActivities}" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <GridSplitter Grid.RowSpan="2"
                          Grid.Column="0"
                          Width="4"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Stretch"
                          Background="Transparent"
                          ShowsPreview="True" />
            <GridSplitter Grid.RowSpan="2"
                          Grid.Column="2"
                          Width="4"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Stretch"
                          Background="Transparent"
                          ShowsPreview="True" />
        </Grid>

        <Grid Grid.RowSpan="2"
              Background="#66000000"
              IsVisible="{Binding Sidebar.IsSearchOverlayVisible}"
              ZIndex="100"
              PointerPressed="OnSearchOverlayPointerPressed">
            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Width="620"
                    Margin="0,56,0,24"
                    Padding="16"
                    CornerRadius="18"
                    Background="#FFFFFFFF"
                    BorderBrush="#E3E5E9"
                    BorderThickness="1">
                <Grid RowDefinitions="Auto,Auto,*" ColumnDefinitions="*">
                    <TextBox x:Name="SearchBox"
                             Grid.Row="0"
                             PlaceholderText="搜索对话"
                             Text="{Binding Sidebar.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              FontSize="{DynamicResource UiFontSize}"
                              Margin="0,0,0,12" />
                    <TextBlock Grid.Row="1"
                               Text="近期对话"
                               FontSize="{DynamicResource UiFontSize}"
                               Foreground="#9096A0"
                               Margin="2,0,0,8" />
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" MaxHeight="420">
                        <ItemsControl ItemsSource="{Binding Sidebar.SearchResults}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:SidebarSessionViewModel">
                                    <Button Classes="search-result-row"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch"
                                            Click="OnSearchResultClick"
                                            CommandParameter="{Binding SessionId}">
                                        <Grid ColumnDefinitions="Auto,*,Auto" Margin="8,6">
                                            <Grid Grid.Column="0" Width="14" Height="14" Margin="0,0,10,0" VerticalAlignment="Center">
                                                <controls:SpinnerControl IsVisible="{Binding IsStreaming}" />
                                                <Ellipse Width="8"
                                                         Height="8"
                                                         Fill="#2F7CF6"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"
                                                         IsVisible="{Binding HasUnreadCompletion}" />
                                            </Grid>
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock Text="{Binding Title}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="#1F2328" />
                                                 <TextBlock Text="{Binding DisplayRelativeTime}"
                                                            FontSize="{DynamicResource UiFontSize}"
                                                            Foreground="#9096A0" />
                                            </StackPanel>
                                             <TextBlock Grid.Column="2"
                                                        Text="{Binding ProjectId}"
                                                        FontSize="{DynamicResource UiFontSize}"
                                                        Foreground="#C5C8CE"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.RowSpan="2"
              Background="#26000000"
              IsVisible="{Binding Chat.HasPendingQuestion}"
              ZIndex="101"
              PointerPressed="OnQuestionBannerPointerPressed">
            <Border Classes="question-banner-card"
                    MaxWidth="960"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="24,56,24,24">
                <Grid RowDefinitions="Auto,*" ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                        <TextBlock Text="{Binding Chat.PendingQuestion.Title}"
                                   Classes="question-banner-title" />
                        <TextBlock Text="{Binding Chat.PendingQuestion.PromptText}"
                                   Classes="question-banner-subtitle"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Row="0"
                            Grid.Column="1"
                            Classes="question-banner-close-button"
                            Command="{Binding Chat.ClosePendingQuestionCommand}"
                            Content="×" />

                    <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Spacing="12" Margin="0,12,0,0">
                        <ItemsControl ItemsSource="{Binding Chat.PendingQuestion.Questions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="chat:PendingQuestionItem">
                                    <StackPanel Spacing="8" Margin="0,6,0,0">
                                        <TextBlock Text="{Binding Header}" Classes="question-item-header" />
                                        <TextBlock Text="{Binding Question}" Classes="question-item-question" TextWrapping="Wrap" />
                                        <ItemsControl ItemsSource="{Binding Options}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Spacing="8" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="chat:PendingQuestionOption">
                                                    <Button Classes="question-option-button"
                                                            HorizontalAlignment="Stretch"
                                                            Command="{Binding DataContext.Chat.SelectPendingQuestionOptionCommand, ElementName=Root}"
                                                            CommandParameter="{Binding}">
                                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                                            <Border Classes="question-option-indicator">
                                                                <TextBlock Text="✓"
                                                                           Classes="question-option-indicator-mark"
                                                                           IsVisible="{Binding IsSelected}" />
                                                            </Border>
                                                            <StackPanel Grid.Column="1" Spacing="2">
                                                                <TextBlock Text="{Binding Label}" Classes="question-option-label" />
                                                                <TextBlock Text="{Binding Description}"
                                                                           Classes="question-option-description"
                                                                           IsVisible="{Binding Description, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"
                                                                           TextWrapping="Wrap" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBox Text="{Binding Chat.PendingQuestion.CustomAnswer, Mode=TwoWay}"
                                 IsVisible="{Binding Chat.PendingQuestion.AllowCustomAnswer}"
                                 Watermark="输入自定义答案"
                                 MinHeight="40" />

                        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Chat.PendingQuestionStatus}"
                                       Classes="question-banner-status"
                                       IsVisible="{Binding Chat.PendingQuestionStatus, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                            <Button Grid.Column="1"
                                    Classes="question-confirm-button"
                                    Command="{Binding Chat.SubmitPendingQuestionCommand}">
                                <TextBlock Text="确认" />
                            </Button>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
