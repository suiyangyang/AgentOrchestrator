<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AgentOrchestrator.App.ViewModels"
             x:Class="AgentOrchestrator.App.Controls.TaskGraphWorkspaceControl"
             x:DataType="vm:TaskGraphWorkspaceViewModel">
    <Grid Background="#FFFFFF">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" MaxWidth="520">
            <Border Classes="task-graph-placeholder-icon">
                <TextBlock Text="🧩" FontSize="36" />
            </Border>
            <TextBlock Text="{Binding Title}"
                       FontSize="20" FontWeight="SemiBold"
                       Foreground="#1F2328"
                       HorizontalAlignment="Center" />
            <TextBlock Text="{Binding Description}"
                        FontSize="{DynamicResource UiFontSize}" Foreground="#6E727A"
                       TextWrapping="Wrap" TextAlignment="Center"
                       HorizontalAlignment="Center" />
            <Border Background="#FFF5ED" CornerRadius="8" Padding="14,8"
                    HorizontalAlignment="Center">
                <TextBlock Text="{Binding ComingSoon}"
                            FontSize="{DynamicResource UiFontSize}" Foreground="#FF6A00" FontWeight="SemiBold" />
            </Border>
            <TextBlock Text="{Binding Hint}"
                        FontSize="{DynamicResource UiFontSize}" Foreground="#9096A0"
                       TextWrapping="Wrap" TextAlignment="Center"
                       HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>
