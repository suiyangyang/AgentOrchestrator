<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AgentOrchestrator.App.ViewModels"
             xmlns:tg="using:AgentOrchestrator.App.Models.TaskGraph"
             xmlns:chat="using:AgentOrchestrator.App.Models.Chat"
             xmlns:conv="using:Avalonia.Data.Converters"
             x:Class="AgentOrchestrator.App.Controls.TaskGraphWorkspaceControl"
             x:Name="Root"
             x:DataType="vm:TaskGraphWorkspaceViewModel"
             Focusable="True">
    <!-- Single-column workspace. The node-details panel that used to live
         here is now hosted by the shell's right sidebar; this control is
         dedicated to the graph surface and its inline toolbars. -->
    <Grid Background="#FFFFFF">
        <Grid Margin="{Binding WorkspaceMargin}"
              RowDefinitions="Auto,Auto,*"
              RowSpacing="12">

            <!-- ============================================================ -->
            <!-- Toolbar 1 — Execution (Save / Run / Continue / Retry / Stop) -->
            <!--   Plus a "More" menu at the end that holds the less-used      -->
            <!--   items (delete node, link mode, etc.) to keep the bar       -->
            <!--   uncluttered.                                               -->
            <!-- ============================================================ -->
            <Grid Grid.Row="0"
                  IsVisible="{Binding IsGraphHeaderVisible}"
                  ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto,Auto"
                  ColumnSpacing="8">
                <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CurrentGraphName}" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding CurrentGraphSummaryText}" Foreground="#6E727A" />
                </StackPanel>

                <!-- Save — always available (writes whatever's in the canvas). -->
                <Button Grid.Column="1"
                        Classes="task-toolbar-btn"
                        Command="{Binding SaveCurrentCommand}"
                        ToolTip.Tip="保存">
                    <Path Classes="toolbar-icon-path toolbar-icon-save" />
                </Button>

                <!-- Execute — primary action. -->
                <Button Grid.Column="2"
                        Classes="task-toolbar-btn task-toolbar-btn-primary"
                        Command="{Binding ExecuteCurrentCommand}"
                        IsEnabled="{Binding CanExecute}"
                        ToolTip.Tip="执行">
                    <Path Classes="toolbar-icon-path toolbar-icon-execute" />
                </Button>

                <!-- Continue — secondary, only after a WaitingForInput gate. -->
                <Button Grid.Column="3"
                        Classes="task-toolbar-btn"
                        Command="{Binding ContinueExecutionCommand}"
                        IsEnabled="{Binding CanContinue}"
                        ToolTip.Tip="继续执行">
                    <Path Classes="toolbar-icon-path toolbar-icon-continue" />
                </Button>

                <!-- Retry failed nodes. -->
                <Button Grid.Column="4"
                        Classes="task-toolbar-btn"
                        Command="{Binding RetryFailedCommand}"
                        IsEnabled="{Binding CanRetryFailed}"
                        ToolTip.Tip="重试失败">
                    <Path Classes="toolbar-icon-path toolbar-icon-retry" />
                </Button>

                <!-- Cancel — only while running. -->
                <Button Grid.Column="5"
                        Classes="task-toolbar-btn task-toolbar-btn-danger"
                        Command="{Binding CancelExecutionCommand}"
                        IsEnabled="{Binding CanCancelExecution}"
                        ToolTip.Tip="取消执行">
                    <Path Classes="toolbar-icon-path toolbar-icon-cancel" />
                </Button>

                <!-- "More" — opens a popup that hosts the less-frequent tools
                     (create from template, link mode, add node, etc.).       -->
                <Button Grid.Column="6"
                        x:Name="MoreButton"
                        Classes="task-toolbar-btn"
                        Click="OnMoreButtonClick"
                        ToolTip.Tip="更多">
                    <Path Classes="toolbar-icon-path toolbar-icon-more" />
                </Button>
            </Grid>

            <!-- ============================================================ -->
            <!-- (Toolbar 2 was merged into the graph editor title bar       -->
            <!--  below — see the "图编辑" header inside the graph surface.) -->
            <!-- ============================================================ -->

            <!-- ============================================================ -->
            <!-- Pending user confirmation banner                             -->
            <!-- ============================================================ -->
            <Border Grid.Row="1"
                    IsVisible="{Binding IsWaitingForUserConfirmation}"
                    Background="#FFF8E7"
                    BorderBrush="#F0D59A"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12">
                <StackPanel Spacing="8">
                    <TextBlock Text="当前编排等待用户确认后继续执行。" FontWeight="SemiBold" />
                    <TextBox Text="{Binding UserConfirmationText, Mode=TwoWay}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MinHeight="72"
                             PlaceholderText="输入用户确认结论或补充意见" />
                </StackPanel>
            </Border>

            <!-- ============================================================ -->
            <!-- Graph surface                                                -->
            <!-- ============================================================ -->
            <Border Grid.Row="2"
                    Background="#F7F8FA"
                    BorderBrush="#E2E5EA"
                    BorderThickness="{Binding GraphSurfaceBorderThickness}"
                    CornerRadius="{Binding GraphSurfaceCornerRadius}">
                <Grid RowDefinitions="Auto,*">
                    <!-- Top bar — "图编辑" title (left) + Add/Delete/AutoLayout
                         buttons + Graph name (centered) + Zoom + Fullscreen (right).
                         This header now hosts the canvas controls that used to
                         live in a standalone toolbar. -->
                    <Border Grid.Row="0"
                            Background="#FFFFFF"
                            BorderBrush="#E2E5EA"
                            BorderThickness="0,0,0,1"
                            Padding="16,8">
                        <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto,Auto,Auto"
                              ColumnSpacing="8">
                            <StackPanel Grid.Column="0"
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        VerticalAlignment="Center">
                                <Path Classes="graph-editor-title-icon"
                                      VerticalAlignment="Center" />
                                <TextBlock Text="图编辑"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="#1F2328"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Classes="task-toolbar-btn"
                                    Command="{Binding AddNodeCommand}"
                                    IsEnabled="{Binding CanAddNode}"
                                    ToolTip.Tip="新增节点">
                                <Path Classes="toolbar-icon-path toolbar-icon-add-node" />
                            </Button>
                            <Button Grid.Column="2"
                                    Classes="task-toolbar-btn"
                                    Click="OnDeleteNodeClick"
                                    IsEnabled="{Binding CanDeleteNode}"
                                    ToolTip.Tip="删除节点（Delete）">
                                <Path Classes="toolbar-icon-path toolbar-icon-delete" />
                            </Button>
                            <Button Grid.Column="3"
                                    Classes="task-toolbar-btn"
                                    Command="{Binding AutoLayoutCommand}"
                                    ToolTip.Tip="自动布局">
                                <Path Classes="toolbar-icon-path toolbar-icon-auto-layout" />
                            </Button>

                            <TextBlock Grid.Column="4"
                                       Text="{Binding CurrentGraphName}"
                                       Foreground="#6E727A"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />

                            <Button Grid.Column="5"
                                    Classes="task-toolbar-btn"
                                    Command="{Binding ZoomOutCommand}"
                                    ToolTip.Tip="缩小">
                                <Path Classes="toolbar-icon-path toolbar-icon-zoom-out" />
                            </Button>
                            <Button Grid.Column="6"
                                    Classes="task-toolbar-btn"
                                    Command="{Binding ResetZoomCommand}"
                                    ToolTip.Tip="还原缩放">
                                <TextBlock Text="{Binding ZoomText}"
                                           FontSize="12"
                                           Foreground="#7A7F87" />
                            </Button>
                            <Button Grid.Column="7"
                                    Classes="task-toolbar-btn"
                                    Command="{Binding ZoomInCommand}"
                                    ToolTip.Tip="放大">
                                <Path Classes="toolbar-icon-path toolbar-icon-zoom-in" />
                            </Button>
                            <Button Grid.Column="8"
                                    Classes="task-toolbar-btn"
                                    Command="{Binding ToggleGraphMaximizeCommand}"
                                    ToolTip.Tip="{Binding GraphMaximizeButtonText}">
                                <Panel>
                                    <Path Classes="toolbar-icon-path graph-fullscreen-enter-icon"
                                          IsVisible="{Binding !IsGraphMaximized}" />
                                    <Path Classes="toolbar-icon-path graph-fullscreen-exit-icon"
                                          IsVisible="{Binding IsGraphMaximized}" />
                                </Panel>
                            </Button>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1"
                                  x:Name="GraphScrollViewer"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <Canvas x:Name="GraphCanvas"
                                    Width="{Binding GraphCanvasWidth}"
                                    Height="{Binding GraphCanvasHeight}"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    PointerMoved="OnCanvasPointerMoved"
                                    PointerReleased="OnCanvasPointerReleased"
                                    PointerWheelChanged="OnCanvasPointerWheelChanged"
                                    Background="#F7F8FA"
                                    Cursor="Hand"
                                    RenderTransformOrigin="0,0">
                                <Canvas.RenderTransform>
                                    <ScaleTransform ScaleX="{Binding GraphZoom}" ScaleY="{Binding GraphZoom}" />
                                </Canvas.RenderTransform>
                            </Canvas>

                            <Border IsVisible="{Binding HasNoCurrentGraph}"
                                    Background="#F7F8FA">
                                <StackPanel HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Spacing="10"
                                            MaxWidth="420">
                                    <TextBlock Text="这里是 TaskGraph 图编辑区"
                                               FontSize="22"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="先点击「更多 → 按模板创建」或拖动空白处平移画布。生成节点后可以从右侧圆点拉线建立依赖，并使用标题栏的工具调整布局。"
                                               TextWrapping="Wrap"
                                               TextAlignment="Center"
                                               Foreground="#6E727A" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ============================================================ -->
        <!-- "More" popup — opens from the toolbar's ⋯ button.             -->
        <!--   Houses the less-frequently-used actions (create from        -->
        <!--   template, link mode, remove links, link-mode toggle, etc.). -->
        <!-- ============================================================ -->
        <Popup x:Name="MorePopup"
               Placement="Bottom"
               PlacementTarget="MoreButton"
               IsLightDismissEnabled="True"
               HorizontalOffset="0"
               VerticalOffset="6">
            <Border Background="#FFFFFF"
                    BorderBrush="#E3E5E9"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="6"
                    BoxShadow="0 8 20 0 #20000000">
                <StackPanel Spacing="2" MinWidth="220">
                    <Button Classes="more-popup-item" Click="OnCreateFromTemplateClick">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Path Classes="toolbar-icon-path toolbar-icon-template" />
                            <TextBlock Text="按模板创建" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="more-popup-item" Click="OnCreateFromDirectClick">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Path Classes="toolbar-icon-path toolbar-icon-direct" />
                            <TextBlock Text="直接输入创建" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="more-popup-item" Click="OnCreateFromIntentClick">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Path Classes="toolbar-icon-path toolbar-icon-intent" />
                            <TextBlock Text="智能编排" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="more-popup-item" Click="OnCreateFromDocumentClick">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Path Classes="toolbar-icon-path toolbar-icon-document" />
                            <TextBlock Text="从文档编排" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Border Background="#E2E5EA" Height="1" Margin="0,4" />
                    <Button Classes="more-popup-item"
                            Command="{Binding ToggleLinkModeCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Path Classes="toolbar-icon-path toolbar-icon-link" />
                            <TextBlock Text="{Binding LinkModeButtonText}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="more-popup-item"
                            Command="{Binding RemoveSelectedNodeLinksCommand}"
                            IsEnabled="{Binding CanRemoveSelectedNodeLinks}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Path Classes="toolbar-icon-path toolbar-icon-link-broken" />
                            <TextBlock Text="清空连线" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Popup>

        <!-- ============================================================ -->
        <!-- Edge midpoint action menu — shown on click. Contains only     -->
        <!-- "删除连线". Dismisses on light-dismiss (click outside).       -->
        <!-- ============================================================ -->
        <Popup x:Name="EdgeActionMenu"
               Placement="Pointer"
               IsLightDismissEnabled="True"
               IsOpen="False">
            <Border Background="#FFFFFF"
                    BorderBrush="#E3E5E9"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="4"
                    BoxShadow="0 4 12 0 #20000000">
                <Button Classes="more-popup-item"
                        x:Name="DeleteEdgeButton"
                        Click="OnDeleteEdgeMenuItemClick"
                        Cursor="Hand">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="删除连线"
                                   FontSize="13"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Border>
        </Popup>

        <!-- ============================================================ -->
        <!-- "Create graph" dialog (template / direct / intent / document) -->
        <!--   Pops up over the workspace. Dismissed via ✕ or backdrop.    -->
        <!-- ============================================================ -->
        <Grid x:Name="CreateDialog"
              IsVisible="{Binding IsCreateDialogVisible}"
              Background="#66000000"
              PointerPressed="OnCreateDialogBackdropPressed">
            <Border Classes="create-dialog-card"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Grid RowDefinitions="Auto,Auto,*,Auto">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Classes="create-dialog-title"
                                       Text="创建任务编排" />
                            <TextBlock Classes="create-dialog-subtitle"
                                       Text="选择一种创建方式，生成后可在右侧栏或图上直接编辑节点。" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Classes="task-toolbar-btn"
                                Click="OnCreateDialogClose"
                                ToolTip.Tip="关闭"
                                Margin="8,0,0,0">
                            <Path Classes="toolbar-icon-path window-close-icon" />
                        </Button>
                    </Grid>

                    <!-- Mode selector -->
                    <StackPanel Grid.Row="1"
                                Orientation="Horizontal"
                                Spacing="8"
                                Margin="0,16,0,12">
                        <ToggleButton Classes="create-dialog-mode"
                                      IsChecked="{Binding IsTemplateModeSelected, Mode=OneWay}"
                                      Click="OnCreateModeClick"
                                      Tag="Template">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Path Classes="toolbar-icon-path toolbar-icon-template" />
                                <TextBlock Text="模板新建" VerticalAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton Classes="create-dialog-mode"
                                      IsChecked="{Binding IsDirectModeSelected, Mode=OneWay}"
                                      Click="OnCreateModeClick"
                                      Tag="Direct">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Path Classes="toolbar-icon-path toolbar-icon-direct" />
                                <TextBlock Text="直接输入" VerticalAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton Classes="create-dialog-mode"
                                      IsChecked="{Binding IsIntentModeSelected, Mode=OneWay}"
                                      Click="OnCreateModeClick"
                                      Tag="Intent">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Path Classes="toolbar-icon-path toolbar-icon-intent" />
                                <TextBlock Text="智能编排" VerticalAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton Classes="create-dialog-mode"
                                      IsChecked="{Binding IsDocumentModeSelected, Mode=OneWay}"
                                      Click="OnCreateModeClick"
                                      Tag="Document">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Path Classes="toolbar-icon-path toolbar-icon-document" />
                                <TextBlock Text="文档编排" VerticalAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>
                    </StackPanel>

                    <!-- Body — one panel visible at a time -->
                    <Border Grid.Row="2" Classes="create-dialog-body">
                        <Grid>
                            <StackPanel Spacing="10" IsVisible="{Binding IsTemplateMode}">
                                <TextBlock Text="选择模板后，可填写编排名称和输入数据。" Foreground="#6E727A" />
                                <Grid ColumnDefinitions="220,*" ColumnSpacing="8">
                                    <ComboBox Grid.Column="0"
                                              Classes="create-dialog-input"
                                              ItemsSource="{Binding Templates}"
                                              SelectedItem="{Binding SelectedTemplate, Mode=TwoWay}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate DataType="vm:TaskGraphTemplateOptionViewModel">
                                                <TextBlock Text="{Binding Title}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBox Grid.Column="1"
                                             Classes="create-dialog-input"
                                             Text="{Binding TemplateGraphName, Mode=TwoWay}"
                                             PlaceholderText="编排名称（可选）" />
                                </Grid>
                                <TextBlock Text="{Binding SelectedTemplate.Description}" Foreground="#6E727A" TextWrapping="Wrap" />
                                <TextBox Classes="create-dialog-input"
                                         Text="{Binding TemplateInputText, Mode=TwoWay}"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         MinHeight="120" />
                            </StackPanel>

                            <StackPanel Spacing="10" IsVisible="{Binding IsDirectMode}">
                                <TextBlock Text="支持 Markdown 列表、`depends on:` 依赖声明和 JSON 输入。" Foreground="#6E727A" />
                                <TextBox Classes="create-dialog-input"
                                         Text="{Binding DirectInputText, Mode=TwoWay}"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         MinHeight="180" />
                            </StackPanel>

                            <StackPanel Spacing="10" IsVisible="{Binding IsIntentMode}">
                                <TextBlock Text="输入一段自然语言需求，让 LLM 生成 DAG 编排。" Foreground="#6E727A" />
                                <TextBox Classes="create-dialog-input"
                                         Text="{Binding IntentInputText, Mode=TwoWay}"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         MinHeight="120" />
                                <Grid ColumnDefinitions="220,180,*" ColumnSpacing="8">
                                    <ComboBox Grid.Column="0"
                                              Classes="create-dialog-input"
                                              ItemsSource="{Binding Permissions}"
                                              SelectedItem="{Binding SelectedPermission, Mode=TwoWay}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate DataType="chat:PermissionOption">
                                                <TextBlock Text="{Binding Title}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <ComboBox Grid.Column="1"
                                              Classes="create-dialog-input"
                                              ItemsSource="{Binding Models}"
                                              SelectedItem="{Binding SelectedModel, Mode=TwoWay}" />
                                </Grid>
                            </StackPanel>

                            <StackPanel Spacing="10" IsVisible="{Binding IsDocumentMode}">
                                <TextBlock Text="导入 `.md` / `.txt` 文档，基于文档内容生成编排。" Foreground="#6E727A" />
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBox Grid.Column="0"
                                             Classes="create-dialog-input"
                                             Text="{Binding DocumentFilePath, Mode=TwoWay}"
                                             PlaceholderText="输入或拖入文档路径" />
                                    <Button Grid.Column="1"
                                            Classes="task-toolbar-btn"
                                            Click="OnBrowseDocumentClick"
                                            ToolTip.Tip="选择文档">
                                        <Path Classes="toolbar-icon-path toolbar-icon-document" />
                                    </Button>
                                </Grid>
                                <TextBox Classes="create-dialog-input"
                                         Text="{Binding DocumentPreviewText, Mode=TwoWay}"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         MinHeight="120" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Footer bar: separated from form body with top border -->
                    <Border Grid.Row="3"
                            Background="#FAFBFC"
                            BorderBrush="#E3E5E9"
                            BorderThickness="0,1,0,0"
                            Padding="0,12">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Spacing="8">
                            <Button Classes="create-dialog-secondary"
                                    Click="OnCreateDialogClose"
                                    Content="取消" />
                            <Button Classes="create-dialog-primary"
                                    Click="OnCreateDialogConfirm"
                                    Content="创建" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
