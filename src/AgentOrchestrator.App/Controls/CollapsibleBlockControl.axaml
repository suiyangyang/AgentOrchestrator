<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AgentOrchestrator.App.ViewModels"
             xmlns:controls="using:AgentOrchestrator.App.Controls"
             x:Class="AgentOrchestrator.App.Controls.CollapsibleBlockControl"
             x:DataType="vm:ChatBlockViewModel">
    <Grid RowDefinitions="Auto,Auto">
        <ToggleButton Grid.Row="0"
                      Classes="collapsible-block"
                      IsChecked="{Binding IsExpanded, Mode=TwoWay}">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto" VerticalAlignment="Center">
                <Panel Width="18" Height="18" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Path Classes="collapsible-block-icon collapsible-block-icon-thought"
                          IsVisible="{Binding ShowThoughtLeadingIcon}" />
                    <Path Classes="collapsible-block-icon collapsible-block-icon-tool"
                          IsVisible="{Binding ShowToolLeadingIcon}" />
                    <controls:SpinnerControl IsVisible="{Binding IsRunning}"
                                             VerticalAlignment="Center"
                                             HorizontalAlignment="Center" />
                </Panel>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="6"
                            VerticalAlignment="Center"
                            Margin="8,0,0,0"
                            IsVisible="{Binding ShowHeaderText}">
                    <!-- Plain header (Thought etc.) -->
                    <TextBlock Text="{Binding HeaderText}"
                               Classes="collapsible-block-label"
                               IsVisible="{Binding ShowPlainHeader}" />
                    <!-- Tool/Task header: action -->
                    <TextBlock Classes="collapsible-block-label"
                               IsVisible="{Binding ShowToolHeader}">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0}">
                                <Binding Path="ToolHeaderActionText" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    <!-- Tool/Task header: file path -->
                    <TextBlock Text="{Binding ToolHeaderFilePathText}"
                               Classes="collapsible-block-label collapsible-block-label-path"
                               IsVisible="{Binding HasToolHeaderFilePath}"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="380" />
                    <!-- Tool/Task header: line range -->
                    <TextBlock Text="{Binding ToolHeaderLineRangeDisplayText}"
                               Classes="collapsible-block-label collapsible-block-label-meta"
                               IsVisible="{Binding HasToolHeaderLineRange}" />
                </StackPanel>
                <Panel Grid.Column="3"
                       Width="16"
                       Height="16"
                       Margin="10,0,0,0"
                       VerticalAlignment="Center">
                    <Path Classes="collapsible-block-chevron" />
                </Panel>
            </Grid>
        </ToggleButton>
        <Border Grid.Row="1" Classes="collapsible-block-body" IsVisible="{Binding IsExpanded}">
            <ContentControl x:Name="Body" />
        </Border>
    </Grid>
</UserControl>
