<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AgentOrchestrator.App.ViewModels"
             x:Class="AgentOrchestrator.App.Controls.SidebarControl"
             x:DataType="vm:SidebarViewModel">
    <Border Background="#F9F9FB" BorderBrush="#E2E5EA" BorderThickness="0,0,1,0">
        <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="0,8,0,0">

            <!-- 新对话 / 搜索 / 任务编排 -->
            <StackPanel Grid.Row="0" Margin="12,4,12,12" Spacing="4">
                <Button Classes="sidebar-nav-entry"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Command="{Binding RequestNewSessionCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <TextBlock Text="✎" Classes="sidebar-nav-icon" />
                        <TextBlock Text="新对话" Classes="sidebar-nav-text" />
                    </StackPanel>
                </Button>
                <Button Classes="sidebar-nav-entry"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Command="{Binding OpenSearchOverlayCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <TextBlock Text="⌕" Classes="sidebar-nav-icon" />
                        <TextBlock Text="搜索" Classes="sidebar-nav-text" />
                    </StackPanel>
                </Button>
                <Button Classes="sidebar-nav-entry"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Command="{Binding RequestTaskGraphCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <TextBlock Text="◌" Classes="sidebar-nav-icon" />
                        <TextBlock Text="插件" Classes="sidebar-nav-text" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- 树: 项目 + 对话 -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="2">

                    <!-- 项目分类头 + 节点 -->
                    <StackPanel>
                        <Button x:Name="ProjectsHeader"
                                Classes="sidebar-section-header"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Click="OnProjectsHeaderClick">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                <TextBlock Grid.Column="0" Text="▾" Classes="sidebar-section-caret" />
                                <TextBlock Grid.Column="1" Text="项目" Classes="sidebar-section-label" />
                                <Button Grid.Column="2"
                                        Classes="sidebar-section-action-btn"
                                        Content="..."
                                        Click="OnProjectSectionMoreClick"
                                        IsVisible="{Binding #ProjectsHeader.IsPointerOver}" />
                                <Button Grid.Column="3"
                                        Classes="sidebar-section-action-btn"
                                        Content="+"
                                        Command="{Binding RequestAddProjectCommand}"
                                        IsVisible="{Binding #ProjectsHeader.IsPointerOver}" />
                            </Grid>
                        </Button>
                        <ItemsControl ItemsSource="{Binding Projects}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:SidebarProjectViewModel">
                                    <StackPanel>
                                        <Button x:Name="ProjectRow"
                                                Classes="sidebar-project-row"
                                                Classes.sidebar-project-row-current="{Binding IsCurrent}"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch"
                                                Click="OnProjectRowClick">
                                            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
                                                <TextBlock Grid.Column="0" Text="📁" Classes="sidebar-project-icon" />
                                                <TextBlock Grid.Column="1" Text="▾" Classes="sidebar-project-caret" />
                                                <TextBlock Grid.Column="2" Text="{Binding Name}" Classes="sidebar-project-name" />
                                                <Button Grid.Column="3"
                                                        Classes="sidebar-row-action-btn"
                                                        Content="..."
                                                        Click="OnProjectRowMoreClick"
                                                        Tag="{Binding Id}"
                                                        IsVisible="{Binding #ProjectRow.IsPointerOver}" />
                                                <Button Grid.Column="4"
                                                        Classes="sidebar-row-action-btn"
                                                        Content="+"
                                                        Click="OnProjectRowAddClick"
                                                        Tag="{Binding Id}"
                                                        IsVisible="{Binding #ProjectRow.IsPointerOver}" />
                                            </Grid>
                                        </Button>
                                        <StackPanel IsVisible="{Binding IsExpanded}" Margin="20,0,0,0">
                                            <ItemsControl ItemsSource="{Binding Sessions}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="vm:SidebarSessionViewModel">
                                                        <Button x:Name="SessionRow"
                                                                Classes="sidebar-session-item"
                                                                Classes.sidebar-session-item-selected="{Binding IsSelected}"
                                                                HorizontalAlignment="Stretch"
                                                                HorizontalContentAlignment="Stretch"
                                                                Click="OnSessionClick">
                                                            <Grid ColumnDefinitions="*,Auto">
                                                                <StackPanel Grid.Column="0" Spacing="2">
                                                                    <TextBlock Text="{Binding Title}" Classes="sidebar-session-title" TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Text="{Binding DisplayRelativeTime}" Classes="sidebar-session-time" />
                                                                </StackPanel>
                                                                <Button Grid.Column="1"
                                                                        Classes="sidebar-row-action-btn"
                                                                        Content="..."
                                                                        Click="OnSessionRowMoreClick"
                                                                        Tag="{Binding SessionId}"
                                                                        IsVisible="{Binding #SessionRow.IsPointerOver}" />
                                                            </Grid>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="暂无对话"
                                                       Classes="sidebar-empty"
                                                       IsVisible="{Binding !HasSessions}" />
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="暂未添加项目"
                                   Classes="sidebar-empty-hint"
                                   IsVisible="{Binding !HasProjects}" />
                    </StackPanel>

                    <!-- 对话分类头 + 节点 (always shown, even when empty) -->
                    <StackPanel Margin="0,8,0,0">
                        <Button x:Name="OrphansHeader"
                                Classes="sidebar-section-header"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Click="OnOrphansHeaderClick">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <TextBlock Grid.Column="0" Text="▾" Classes="sidebar-section-caret" />
                                <TextBlock Grid.Column="1" Text="对话" Classes="sidebar-section-label" />
                                <Button Grid.Column="2"
                                        Classes="sidebar-section-action-btn"
                                        Content="+"
                                        Command="{Binding RequestNewSessionCommand}"
                                        IsVisible="{Binding #OrphansHeader.IsPointerOver}" />
                            </Grid>
                        </Button>
                        <ItemsControl ItemsSource="{Binding OrphanSessions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:SidebarSessionViewModel">
                                    <Button x:Name="OrphanSessionRow"
                                            Classes="sidebar-session-item"
                                            Classes.sidebar-session-item-selected="{Binding IsSelected}"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch"
                                            Margin="10,0,4,0"
                                            Click="OnSessionClick">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0" Spacing="2">
                                                <TextBlock Text="{Binding Title}" Classes="sidebar-session-title" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding DisplayRelativeTime}" Classes="sidebar-session-time" />
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    Classes="sidebar-row-action-btn"
                                                    Content="..."
                                                    Click="OnSessionRowMoreClick"
                                                    Tag="{Binding SessionId}"
                                                    IsVisible="{Binding #OrphanSessionRow.IsPointerOver}" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="暂无未归属的对话"
                                   Classes="sidebar-empty" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Shared Popup for the "..." menus. We relocate it on each click. -->
            <Popup x:Name="RowActionPopup"
                   Placement="Right"
                   IsLightDismissEnabled="True">
                <Border Classes="popup-shell" Padding="4">
                    <StackPanel x:Name="RowActionPanel" Spacing="2" />
                </Border>
            </Popup>
        </Grid>
    </Border>
</UserControl>
