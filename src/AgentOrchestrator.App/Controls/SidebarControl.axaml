<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AgentOrchestrator.App.ViewModels"
             xmlns:controls="using:AgentOrchestrator.App.Controls"
             x:Class="AgentOrchestrator.App.Controls.SidebarControl"
             x:DataType="vm:SidebarViewModel">
    <Border Background="#F9F9FB" BorderBrush="#E2E5EA" BorderThickness="0,0,1,0">
        <Grid RowDefinitions="Auto,*" Margin="0,8,0,0">

            <!-- 新对话 / 搜索 -->
            <StackPanel Grid.Row="0" Margin="12,4,12,12" Spacing="4">
                <Button Classes="sidebar-nav-entry"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Command="{Binding RequestNewSessionCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Path Classes="sidebar-nav-icon-path sidebar-new-chat-icon" />
                        <TextBlock Text="新对话" Classes="sidebar-nav-text" />
                    </StackPanel>
                </Button>
                <Button Classes="sidebar-nav-entry"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Command="{Binding OpenSearchOverlayCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Path Classes="sidebar-nav-icon-path sidebar-search-icon" />
                        <TextBlock Text="搜索" Classes="sidebar-nav-text" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- 树: 项目 + 对话 -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="2">

                    <!-- 项目分类头 + 节点 -->
                    <StackPanel>
                        <Button x:Name="ProjectsHeader"
                                Classes="sidebar-section-header"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Click="OnProjectsHeaderClick">
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                                <TextBlock Grid.Column="0" Text="项目" Classes="sidebar-section-label" />
                                <Path Grid.Column="1"
                                      Classes="sidebar-chevron sidebar-section-caret"
                                      Classes.sidebar-chevron-expanded="{Binding AreProjectsExpanded}" />
                                <Button Grid.Column="2"
                                        Classes="sidebar-section-action-btn"
                                        Click="OnProjectSectionMoreClick"
                                        IsVisible="{Binding #ProjectsHeader.IsPointerOver}">
                                    <Path Classes="sidebar-action-icon sidebar-more-icon" />
                                </Button>
                                <Button Grid.Column="3"
                                        Classes="sidebar-section-action-btn"
                                        Command="{Binding RequestAddProjectCommand}"
                                        IsVisible="{Binding #ProjectsHeader.IsPointerOver}">
                                    <Path Classes="sidebar-action-icon sidebar-plus-icon" />
                                </Button>
                            </Grid>
                        </Button>
                        <ItemsControl ItemsSource="{Binding Projects}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:SidebarProjectViewModel">
                                    <StackPanel>
                                        <Button x:Name="ProjectRow"
                                                Classes="sidebar-project-row"
                                                Classes.sidebar-project-row-current="{Binding IsCurrent}"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch"
                                                Click="OnProjectRowClick">
                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                                                <Path Grid.Column="0" Classes="sidebar-project-icon sidebar-folder-icon" />
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" Classes="sidebar-project-name" />
                                                <Path Grid.Column="2"
                                                      Classes="sidebar-chevron sidebar-project-caret"
                                                      Classes.sidebar-chevron-expanded="{Binding IsExpanded}" />
                                                <Button Grid.Column="3"
                                                        Classes="sidebar-row-action-btn"
                                                        Click="OnProjectRowMoreClick"
                                                        Tag="{Binding Id}"
                                                        IsVisible="{Binding #ProjectRow.IsPointerOver}">
                                                    <Path Classes="sidebar-action-icon sidebar-more-icon" />
                                                </Button>
                                                <Button Grid.Column="4"
                                                        Classes="sidebar-row-action-btn"
                                                        Click="OnProjectRowAddClick"
                                                        Tag="{Binding Id}"
                                                        IsVisible="{Binding #ProjectRow.IsPointerOver}">
                                                    <Path Classes="sidebar-action-icon sidebar-plus-icon" />
                                                </Button>
                                            </Grid>
                                        </Button>
                                        <StackPanel IsVisible="{Binding IsExpanded}" Margin="20,0,0,0">
                                            <ItemsControl ItemsSource="{Binding VisibleSessions}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="vm:SidebarSessionViewModel">
                                                        <Button x:Name="SessionRow"
                                                                 Classes="sidebar-session-item"
                                                                 Classes.sidebar-session-item-selected="{Binding IsSelected}"
                                                                 HorizontalAlignment="Stretch"
                                                                 HorizontalContentAlignment="Stretch"
                                                                 Click="OnSessionClick">
                                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="6">
                                                                <Grid Grid.Column="0" Width="14" Height="14" VerticalAlignment="Center">
                                                                    <controls:SpinnerControl IsVisible="{Binding IsStreaming}" />
                                                                    <Ellipse Width="8"
                                                                             Height="8"
                                                                             Fill="#2F7CF6"
                                                                             HorizontalAlignment="Center"
                                                                             VerticalAlignment="Center"
                                                                             IsVisible="{Binding HasUnreadCompletion}" />
                                                                </Grid>
                                                                <TextBlock Grid.Column="1"
                                                                           Text="{Binding Title}"
                                                                           Classes="sidebar-session-title"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           VerticalAlignment="Center" />
                                                                <TextBlock Grid.Column="2"
                                                                           Text="{Binding DisplayRelativeTime}"
                                                                           Classes="sidebar-session-time"
                                                                           VerticalAlignment="Center" />
                                                                <Button Grid.Column="3"
                                                                        Classes="sidebar-row-action-btn"
                                                                        Click="OnSessionRowMoreClick"
                                                                        Tag="{Binding SessionId}"
                                                                        IsVisible="{Binding #SessionRow.IsPointerOver}">
                                                                    <Path Classes="sidebar-action-icon sidebar-more-icon" />
                                                                </Button>
                                                            </Grid>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <StackPanel Orientation="Horizontal"
                                                        Spacing="12"
                                                        Margin="10,2,4,0"
                                                        IsVisible="{Binding HasSessionPaginationControls}">
                                                <Button Classes="sidebar-session-page-action"
                                                        Content="展开显示"
                                                        Click="OnProjectSessionExpandClick"
                                                        IsVisible="{Binding HasMoreSessions}" />
                                                <Button Classes="sidebar-session-page-action"
                                                        Content="折叠显示"
                                                        Click="OnProjectSessionCollapseClick"
                                                        IsVisible="{Binding CanCollapseSessions}" />
                                            </StackPanel>
                                            <TextBlock Text="暂无对话"
                                                       Classes="sidebar-empty"
                                                       IsVisible="{Binding !HasSessions}" />
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="暂未添加项目"
                                   Classes="sidebar-empty-hint"
                                   IsVisible="{Binding !HasProjects}" />
                    </StackPanel>

                    <!-- 对话分类头 + 节点 (always shown, even when empty) -->
                    <StackPanel Margin="0,8,0,0">
                        <Button x:Name="OrphansHeader"
                                Classes="sidebar-section-header"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Click="OnOrphansHeaderClick">
                            <Grid ColumnDefinitions="*,Auto,Auto">
                                <TextBlock Grid.Column="0" Text="对话" Classes="sidebar-section-label" />
                                <Path Grid.Column="1"
                                      Classes="sidebar-chevron sidebar-section-caret"
                                      Classes.sidebar-chevron-expanded="{Binding IsOrphansExpanded}" />
                                <Button Grid.Column="2"
                                        Classes="sidebar-section-action-btn"
                                        Command="{Binding RequestNewSessionCommand}"
                                        IsVisible="{Binding #OrphansHeader.IsPointerOver}">
                                    <Path Classes="sidebar-action-icon sidebar-plus-icon" />
                                </Button>
                            </Grid>
                        </Button>
                        <ItemsControl ItemsSource="{Binding OrphanSessions}"
                                      IsVisible="{Binding IsOrphansExpanded}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:SidebarSessionViewModel">
                                    <Button x:Name="OrphanSessionRow"
                                            Classes="sidebar-session-item"
                                            Classes.sidebar-session-item-selected="{Binding IsSelected}"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch"
                                            Margin="10,0,4,0"
                                            Click="OnSessionClick">
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="6">
                                            <Grid Grid.Column="0" Width="14" Height="14" VerticalAlignment="Center">
                                                <controls:SpinnerControl IsVisible="{Binding IsStreaming}" />
                                                <Ellipse Width="8"
                                                         Height="8"
                                                         Fill="#2F7CF6"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"
                                                         IsVisible="{Binding HasUnreadCompletion}" />
                                            </Grid>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Title}"
                                                       Classes="sidebar-session-title"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding DisplayRelativeTime}"
                                                       Classes="sidebar-session-time"
                                                       VerticalAlignment="Center" />
                                            <Button Grid.Column="3"
                                                    Classes="sidebar-row-action-btn"
                                                    Click="OnSessionRowMoreClick"
                                                    Tag="{Binding SessionId}"
                                                    IsVisible="{Binding #OrphanSessionRow.IsPointerOver}">
                                                <Path Classes="sidebar-action-icon sidebar-more-icon" />
                                            </Button>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="暂无未归属的对话"
                                   Classes="sidebar-empty"
                                   IsVisible="{Binding IsOrphansExpanded}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Shared Popup for the "..." menus. We relocate it on each click. -->
            <Popup x:Name="RowActionPopup"
                   Placement="Right"
                   IsLightDismissEnabled="True">
                <Border Classes="popup-shell" Padding="4">
                    <StackPanel x:Name="RowActionPanel" Spacing="2" />
                </Border>
            </Popup>
        </Grid>
    </Border>
</UserControl>
