<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AgentOrchestrator.App.ViewModels"
             xmlns:controls="using:AgentOrchestrator.App.Controls"
             x:Class="AgentOrchestrator.App.Controls.TaskOrchestrationWorkspaceControl"
             x:Name="Root"
             x:DataType="vm:TaskOrchestrationWorkspaceViewModel"
             Focusable="True">

    <Grid Background="#F7F8FA">
        <Border Background="#F7F8FA"
                Padding="0">
            <Grid>
                <!-- Empty state -->
                <Border Classes="orch-empty-hint"
                        IsVisible="{Binding Editor.IsEmpty}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <StackPanel Spacing="12" HorizontalAlignment="Center">
                        <Path Classes="sidebar-nav-icon-path sidebar-orchestrator-icon"
                              Width="32" Height="32"
                              HorizontalAlignment="Center" />
                        <TextBlock Text="从模板或既有任务图开始"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#6E727A"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="左侧选择一个模板来编辑和生成任务图，或选择一个已有任务图查看并执行。"
                                   FontSize="13"
                                   Foreground="#9096A0"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   MaxWidth="320" />
                    </StackPanel>
                </Border>

                <!-- Document view: graph canvas on top, editor panel on bottom -->
                <Grid IsVisible="{Binding Editor.HasDocument}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Graph canvas — reuses the shared TaskGraphWorkspaceControl -->
                    <Border Grid.Row="0">
                        <controls:TaskGraphWorkspaceControl DataContext="{Binding Workspace}"/>
                    </Border>

                    <!-- Editor panel — template rules or runtime info -->
                    <Border Grid.Row="1"
                            Background="#FFFFFF"
                            BorderBrush="#E2E5EA"
                            BorderThickness="0,1,0,0"
                            MaxHeight="320">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="14" Margin="16,14,16,14">

                                <!-- ============================================ -->
                                <!-- Template mode editor                        -->
                                <!-- ============================================ -->
                                <Border IsVisible="{Binding Editor.IsTemplateDocument}">
                                    <StackPanel Spacing="12">
                                        <TextBlock Text="模板编辑"
                                                   Classes="orch-detail-title" />

                                        <!-- Name -->
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="模板名称" Classes="orch-detail-meta" />
                                            <TextBox Text="{Binding Editor.Name, Mode=TwoWay}"
                                                     Classes="orch-detail-input"
                                                     IsReadOnly="{Binding Editor.IsBuiltInTemplate}" />
                                        </StackPanel>

                                        <!-- Notes -->
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="模板说明 Note" Classes="orch-detail-meta" />
                                            <TextBox Text="{Binding Editor.TemplateNotesDraft, Mode=TwoWay}"
                                                     Classes="orch-detail-input"
                                                     AcceptsReturn="True"
                                                     TextWrapping="Wrap"
                                                     MinHeight="60"
                                                     IsReadOnly="{Binding Editor.IsBuiltInTemplate}" />
                                        </StackPanel>

                                        <!-- Planner Prompt -->
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="Planner 提示词" Classes="orch-detail-meta" />
                                            <TextBox Text="{Binding Editor.TemplatePlannerPromptDraft, Mode=TwoWay}"
                                                     Classes="orch-detail-input"
                                                     AcceptsReturn="True"
                                                     TextWrapping="Wrap"
                                                     MinHeight="40"
                                                     IsReadOnly="{Binding Editor.IsBuiltInTemplate}" />
                                        </StackPanel>

                                        <!-- Template rules -->
                                        <TextBlock Text="模板规则" Classes="orch-detail-title" />
                                        <CheckBox IsChecked="{Binding Editor.AllowDynamicExpansion, Mode=TwoWay}"
                                                  Content="允许动态扩图"
                                                  IsEnabled="{Binding Editor.CanEditTemplateRules}" />

                                        <TextBlock Text="动态区域" Classes="orch-detail-meta" />
                                        <ItemsControl ItemsSource="{Binding Editor.DynamicZones}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="#E2E5EA"
                                                            BorderThickness="1"
                                                            CornerRadius="6"
                                                            Padding="10,8"
                                                            Margin="0,0,0,6">
                                                        <StackPanel Spacing="6">
                                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                                                <TextBlock Grid.Column="0"
                                                                           Text="名称"
                                                                           VerticalAlignment="Center"
                                                                           Foreground="#6E727A"
                                                                           FontSize="13" />
                                                                <TextBox Grid.Column="1"
                                                                         Text="{Binding Name, Mode=TwoWay}"
                                                                         FontSize="13" />
                                                            </Grid>
                                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                                                <TextBlock Grid.Column="0"
                                                                           Text="锚点节点"
                                                                           VerticalAlignment="Center"
                                                                           Foreground="#6E727A"
                                                                           FontSize="13" />
                                                                <TextBox Grid.Column="1"
                                                                         Text="{Binding AnchorNodeId, Mode=TwoWay}"
                                                                         FontSize="13" />
                                                            </Grid>
                                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                                                <TextBlock Grid.Column="0"
                                                                           Text="插入位置"
                                                                           VerticalAlignment="Center"
                                                                           Foreground="#6E727A"
                                                                           FontSize="13" />
                                                                <TextBox Grid.Column="1"
                                                                         Text="{Binding InsertAfterNodeId, Mode=TwoWay}"
                                                                         FontSize="13" />
                                                            </Grid>
                                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                                                <TextBlock Grid.Column="0"
                                                                           Text="连接到终端"
                                                                           VerticalAlignment="Center"
                                                                           Foreground="#6E727A"
                                                                           FontSize="13" />
                                                                <TextBox Grid.Column="1"
                                                                         Text="{Binding ConnectToTerminalNodeId, Mode=TwoWay}"
                                                                         FontSize="13" />
                                                            </Grid>
                                                            <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="12">
                                                                <CheckBox IsChecked="{Binding AllowParallelNodes, Mode=TwoWay}"
                                                                          Content="允许并行节点" />
                                                                <Border Grid.Column="1">
                                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                                        <TextBlock Text="最大节点数"
                                                                                   VerticalAlignment="Center"
                                                                                   Foreground="#6E727A"
                                                                                   FontSize="13" />
                                                                        <TextBox Text="{Binding MaxGeneratedNodeCount, Mode=TwoWay}"
                                                                                 Width="60"
                                                                                 FontSize="13" />
                                                                    </StackPanel>
                                                                </Border>
                                                            </Grid>
                                                            <StackPanel Spacing="2">
                                                                <TextBlock Text="生成指令"
                                                                           Foreground="#6E727A"
                                                                           FontSize="13" />
                                                                <TextBox Text="{Binding GenerationInstruction, Mode=TwoWay}"
                                                                         AcceptsReturn="True"
                                                                         TextWrapping="Wrap"
                                                                         MinHeight="40"
                                                                         FontSize="13" />
                                                            </StackPanel>
                                                            <Button Content="删除"
                                                                    HorizontalAlignment="Right"
                                                                    Click="OnDeleteZoneClick"
                                                                    Tag="{Binding}"
                                                                    Classes="orch-secondary-btn" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Button Content="+ 添加动态区域"
                                                Command="{Binding Editor.AddDynamicZoneCommand}"
                                                IsEnabled="{Binding Editor.CanEditTemplateRules}"
                                                Classes="orch-secondary-btn" />

                                        <!-- Actions -->
                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="8"
                                                    HorizontalAlignment="Right"
                                                    Margin="0,8,0,0">
                                            <Button Content="保存模板"
                                                    Command="{Binding Editor.SaveCommand}"
                                                    IsEnabled="{Binding Editor.CanSave}"
                                                    Classes="orch-secondary-btn" />
                                            <Button Content="基于此模板生成任务图"
                                                    Command="{Binding Editor.InstantiateCommand}"
                                                    IsEnabled="{Binding Editor.CanInstantiate}"
                                                    Classes="orch-primary-btn" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- ============================================ -->
                                <!-- Runtime mode info                           -->
                                <!-- ============================================ -->
                                <Border IsVisible="{Binding Editor.IsRuntimeDocument}">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="任务图信息"
                                                   Classes="orch-detail-title" />
                                        <TextBlock Text="{Binding Editor.Name}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="#1F2328" />
                                        <TextBlock Text="当前模式: 任务图（可执行）"
                                                   FontSize="13"
                                                   Foreground="#6E727A" />
                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="8"
                                                    HorizontalAlignment="Right"
                                                    Margin="0,4,0,0">
                                            <Button Content="保存"
                                                    Command="{Binding Editor.SaveCommand}"
                                                    IsEnabled="{Binding Editor.CanSave}"
                                                    Classes="orch-secondary-btn" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
