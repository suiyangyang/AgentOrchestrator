<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AgentOrchestrator.App.ViewModels"
             xmlns:chat="using:AgentOrchestrator.App.Models.Chat"
              xmlns:controls="using:AgentOrchestrator.App.Controls"
              xmlns:conv="using:Avalonia.Data.Converters"
             x:Class="AgentOrchestrator.App.Controls.ChatWorkspaceControl"
             x:Name="Root"
             x:DataType="vm:ChatWorkspaceViewModel">
     <Grid RowDefinitions="*,Auto,Auto" Background="#FFFFFF">
         <ScrollViewer x:Name="MessagesScrollViewer" Grid.Row="0" VerticalScrollBarVisibility="Auto">
                 <ItemsControl ItemsSource="{Binding Messages}" Margin="38,18,38,16">
                 <ItemsControl.ItemTemplate>
                     <DataTemplate DataType="vm:ChatMessageViewModel">
                         <Grid Margin="0,0,0,14">
                             <StackPanel Spacing="10" MaxWidth="900">
                                 <Border Classes="user-bubble"
                                         IsVisible="{Binding IsUser}"
                                         HorizontalAlignment="Right">
                                     <ItemsControl ItemsSource="{Binding Blocks}">
                                         <ItemsControl.ItemsPanel>
                                             <ItemsPanelTemplate>
                                                 <StackPanel Spacing="14" />
                                             </ItemsPanelTemplate>
                                         </ItemsControl.ItemsPanel>
                                         <ItemsControl.ItemTemplate>
                                             <DataTemplate DataType="vm:ChatBlockViewModel">
                                                 <StackPanel>
                                                     <controls:MarkdownBlockControl IsVisible="{Binding IsText}" DataContext="{Binding}" />
                                                     <controls:CollapsibleBlockControl IsVisible="{Binding IsThought}" DataContext="{Binding}" />
                                                     <controls:CollapsibleBlockControl IsVisible="{Binding IsTool}" DataContext="{Binding}" />
                                                     <controls:CollapsibleBlockControl IsVisible="{Binding IsTask}" DataContext="{Binding}" />
                                                     <Border Classes="inline-attachment"
                                                             IsVisible="{Binding IsImage}">
                                                         <StackPanel Orientation="Horizontal" Spacing="10">
                                                             <Border Classes="mini-file-icon">
                                                                 <TextBlock Text="+" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                             </Border>
                                                             <TextBlock Text="{Binding Text}" VerticalAlignment="Center" FontSize="{DynamicResource UiFontSize}" />
                                                         </StackPanel>
                                                     </Border>
                                                 </StackPanel>
                                             </DataTemplate>
                                         </ItemsControl.ItemTemplate>
                                     </ItemsControl>
                                 </Border>

                                 <StackPanel Spacing="14"
                                             IsVisible="{Binding IsAssistant}">
                                     <StackPanel Orientation="Horizontal"
                                                 Spacing="10"
                                                 IsVisible="{Binding ShowStreamingPlaceholder}">
                                         <Border Classes="assistant-loading-dot-shell">
                                             <Border Classes="assistant-loading-dot" />
                                         </Border>
                                         <TextBlock Text="Codex"
                                                    Classes="assistant-loading-text"
                                                    VerticalAlignment="Center" />
                                     </StackPanel>
                                     <TextBlock Text="{Binding StreamingStatusText}"
                                                IsVisible="{Binding StreamingStatusText, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"
                                                Classes="assistant-loading-text"
                                                VerticalAlignment="Center" />
                                     <ItemsControl ItemsSource="{Binding Blocks}">
                                         <ItemsControl.ItemsPanel>
                                             <ItemsPanelTemplate>
                                                 <StackPanel Spacing="14" />
                                             </ItemsPanelTemplate>
                                         </ItemsControl.ItemsPanel>
                                         <ItemsControl.ItemTemplate>
                                             <DataTemplate DataType="vm:ChatBlockViewModel">
                                                 <StackPanel>
                                                     <controls:MarkdownBlockControl IsVisible="{Binding IsText}" DataContext="{Binding}" />
                                                     <controls:CollapsibleBlockControl IsVisible="{Binding IsThought}" DataContext="{Binding}" />
                                                     <controls:CollapsibleBlockControl IsVisible="{Binding IsTool}" DataContext="{Binding}" />
                                                     <controls:CollapsibleBlockControl IsVisible="{Binding IsTask}" DataContext="{Binding}" />
                                                     <Border Classes="inline-attachment"
                                                             IsVisible="{Binding IsImage}">
                                                         <StackPanel Orientation="Horizontal" Spacing="10">
                                                             <Border Classes="mini-file-icon">
                                                                 <TextBlock Text="+" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                             </Border>
                                                             <TextBlock Text="{Binding Text}" VerticalAlignment="Center" FontSize="{DynamicResource UiFontSize}" />
                                                         </StackPanel>
                                                     </Border>
                                                 </StackPanel>
                                             </DataTemplate>
                                         </ItemsControl.ItemTemplate>
                                     </ItemsControl>
                                 </StackPanel>
                             </StackPanel>
                         </Grid>
                     </DataTemplate>
                 </ItemsControl.ItemTemplate>
             </ItemsControl>
         </ScrollViewer>

         <!-- Row 1: TaskGraph orchestration strip -->
         <Border Grid.Row="1" Classes="taskgraph-strip" Margin="38,8,38,0" Padding="12,10">
             <Panel>
                 <!-- Auto-pilot strip: visible when no active graph -->
                 <StackPanel Spacing="8" Orientation="Horizontal" VerticalAlignment="Center"
                             IsVisible="{Binding ShowAutoPilotStrip}">
                     <TextBlock Text="编排:" VerticalAlignment="Center" FontWeight="SemiBold" />
                     <Button Content="自动编排" Command="{Binding TriggerAutoTaskGraphCommand}"
                             Classes="taskgraph-strip-button" />
                     <Separator Width="1" Height="20" Background="#E0E3E8" />
                     <Button Content="任务列表" Command="{Binding TriggerTaskListTemplateCommand}"
                             Classes="taskgraph-strip-button" />
                     <Button Content="功能开发" Command="{Binding TriggerFeatureDevTemplateCommand}"
                             Classes="taskgraph-strip-button" />
                     <Button Content="Bug 列表" Command="{Binding TriggerBugListTemplateCommand}"
                             Classes="taskgraph-strip-button" />
                 </StackPanel>

                 <!-- Status card: visible when HasActiveGraph -->
                 <Border IsVisible="{Binding HasActiveGraph}" Padding="4,0">
                     <Grid ColumnDefinitions="*,Auto">
                         <StackPanel Spacing="3" VerticalAlignment="Center">
                             <TextBlock Text="{Binding ActiveGraph.Name}"
                                        FontWeight="SemiBold" FontSize="{DynamicResource UiFontSize}" Foreground="#1F2328" />
                             <StackPanel Orientation="Horizontal" Spacing="12">
                                 <TextBlock FontSize="12" Foreground="#6E727A"
                                            Text="{Binding ActiveExecutionContext.CurrentRunningNodeId}" />
                             </StackPanel>
                             <StackPanel Orientation="Horizontal" Spacing="16">
                                 <TextBlock FontSize="11" Foreground="#18A558">
                                     <Run Text="已完成: " />
                                     <Run Text="{Binding ActiveExecutionContext.RecentCompletedNodes.Count}" />
                                 </TextBlock>
                                 <TextBlock FontSize="11" Foreground="#D73A49">
                                     <Run Text="已失败: " />
                                     <Run Text="{Binding ActiveExecutionContext.RecentFailedNodes.Count}" />
                                 </TextBlock>
                                 <TextBlock FontSize="11" Foreground="#FF6A00">
                                     <Run Text="待决策: " />
                                     <Run Text="{Binding ActiveExecutionContext.PendingDecisions.Count}" />
                                 </TextBlock>
                             </StackPanel>
                         </StackPanel>
                         <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                             <Button Content="暂停" Command="{Binding PauseActiveGraphCommand}"
                                     Classes="taskgraph-strip-button" />
                             <Button Content="取消" Command="{Binding CancelActiveGraphCommand}"
                                     Classes="taskgraph-strip-button" />
                             <Button Content="继续" Command="{Binding ResumeContinueGraphCommand}"
                                     Classes="taskgraph-strip-button" />
                             <Button Content="汇总" Command="{Binding ResumeSummarizeGraphCommand}"
                                     Classes="taskgraph-strip-button" />
                             <Button Content="分离" Command="{Binding ExecuteDetachActiveGraphCommand}"
                                     Classes="taskgraph-strip-button" />
                         </StackPanel>
                     </Grid>
                 </Border>
             </Panel>
         </Border>

         <Border Grid.Row="2"
                Classes="composer-shell"
                HorizontalAlignment="Stretch"
                MaxWidth="900"
                Margin="38,0,38,22">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                <ItemsControl Grid.Row="0"
                              ItemsSource="{Binding QueuedDrafts}"
                              IsVisible="{Binding HasQueuedDrafts}"
                              Margin="0,0,0,10">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:QueuedChatDraftViewModel">
                            <Border Classes="queue-item-shell" Margin="0,0,0,8">
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="10" VerticalAlignment="Center">
                                    <TextBlock Text="↪" Classes="queue-item-icon" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding DisplayText}"
                                               Classes="queue-item-text"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                    <Button Grid.Column="2"
                                            Classes="queue-item-action"
                                            Command="{Binding #Root.DataContext.RestoreQueuedDraftCommand}"
                                            CommandParameter="{Binding}">
                                        <TextBlock Text="↳ 引导" Classes="queue-item-action-text" />
                                    </Button>
                                    <Button Grid.Column="3"
                                            Classes="queue-item-action"
                                            Command="{Binding #Root.DataContext.RemoveQueuedDraftCommand}"
                                            CommandParameter="{Binding}">
                                        <TextBlock Text="🗑" Classes="queue-item-action-icon" />
                                    </Button>
                                    <Button Grid.Column="4"
                                            Classes="queue-item-action"
                                            Content="⋯" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ItemsControl Grid.Row="1"
                              ItemsSource="{Binding Attachments}"
                              IsVisible="{Binding HasAttachments}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="chat:ChatAttachment">
                            <Panel>
                                <Border Classes="inline-attachment"
                                        Margin="0,0,8,8"
                                        IsVisible="{Binding !IsImage}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Classes="mini-file-icon">
                                            <TextBlock Text="+" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" FontSize="{DynamicResource UiFontSize}" />
                                        <Button Command="{Binding #Root.DataContext.RemoveAttachmentCommand}"
                                                CommandParameter="{Binding}"
                                                Classes="mini-close-button"
                                                Content="×" />
                                    </StackPanel>
                                </Border>

                                <Panel IsVisible="{Binding IsImage}"
                                       Margin="0,0,8,8"
                                       Width="68"
                                       Height="84">
                                    <Border Classes="image-thumbnail">
                                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                    </Border>
                                    <Button Command="{Binding #Root.DataContext.RemoveAttachmentCommand}"
                                            CommandParameter="{Binding}"
                                            Classes="attachment-close-overlay"
                                            Content="×"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Margin="0,4,4,0" />
                                </Panel>
                            </Panel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid Grid.Row="2">
                    <TextBox Text="{Binding DraftText, Mode=TwoWay}"
                              AcceptsReturn="False"
                              TextWrapping="Wrap"
                              BorderThickness="0"
                              Background="Transparent"
                              MinHeight="64"
                              PlaceholderText="要求后续变更"
                               FontSize="{DynamicResource UiFontSize}"
                               FontFamily="{DynamicResource UiFontFamily}"
                              KeyDown="OnDraftKeyDown"
                              PastingFromClipboard="OnDraftPasting" />
                </Grid>

                <Grid Grid.Row="3" ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto" VerticalAlignment="Center" Margin="0,12,0,0">
                    <Button Grid.Column="0" Classes="toolbar-icon-button" Command="{Binding AddAttachmentCommand}">
                        <TextBlock Text="+" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" />
                    </Button>

                    <Button Grid.Column="1"
                            x:Name="PermissionAnchor"
                            Classes="permission-pill"
                            Click="OnPermissionClick"
                            HorizontalContentAlignment="Left"
                            Padding="10,0"
                            Margin="8,0,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="🛡!" Classes="permission-warning-icon" />
                            <TextBlock Text="{Binding SelectedPermission.Title}" Classes="permission-pill-text" />
                            <Path Classes="permission-caret" />
                        </StackPanel>
                    </Button>

                    <Popup x:Name="PermissionPopup"
                           Placement="Bottom"
                           PlacementTarget="{Binding #PermissionAnchor}"
                           IsLightDismissEnabled="True">
                        <Border Classes="popup-shell">
                            <ItemsControl ItemsSource="{Binding Permissions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="chat:PermissionOption">
                                        <Button Classes="permission-item" Click="OnPermissionItemClick" CommandParameter="{Binding}">
                                            <Grid ColumnDefinitions="Auto,*,Auto" Margin="4">
                                                <Border Classes="permission-item-icon">
                                                    <TextBlock Text="{Binding Icon}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Spacing="3" Margin="12,0,12,0">
                                                    <TextBlock Text="{Binding Title}" Classes="permission-title" />
                                                    <TextBlock Text="{Binding Description}" Classes="permission-description" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2"
                                                           Text="✓"
                                                           VerticalAlignment="Center"
                                                           FontSize="16"
                                                           IsVisible="{Binding IsSelected}" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </Popup>

                    <Button Grid.Column="2"
                            x:Name="ModelAnchor"
                            Classes="model-pill"
                            Click="OnModelClick"
                            Margin="8,0,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedModel}" Classes="model-text" />
                            <Path Classes="model-caret" />
                        </StackPanel>
                    </Button>

                    <Popup x:Name="ModelPopup"
                           Placement="Bottom"
                           PlacementTarget="{Binding #ModelAnchor}"
                           IsLightDismissEnabled="True">
                        <Border Classes="popup-shell">
                            <ItemsControl ItemsSource="{Binding Models}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Classes="permission-item" Click="OnModelItemClick" CommandParameter="{Binding}">
                                             <TextBlock Text="{Binding .}" FontSize="{DynamicResource UiFontSize}" />
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </Popup>

                    <Button Grid.Column="5" Classes="send-circle-button" Command="{Binding PrimaryActionCommand}">
                        <Grid Width="30" Height="30">
                            <Path Classes="composer-send-icon"
                                  IsVisible="{Binding ShowSendButton}" />
                            <Border Classes="composer-stop-icon"
                                    IsVisible="{Binding ShowStopButton}" />
                        </Grid>
                    </Button>
                </Grid>

            </Grid>
        </Border>
    </Grid>
</UserControl>
