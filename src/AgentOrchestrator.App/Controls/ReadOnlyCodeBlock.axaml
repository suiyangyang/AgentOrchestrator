<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:AgentOrchestrator.App.Controls"
             x:Class="AgentOrchestrator.App.Controls.ReadOnlyCodeBlock">
    <ScrollViewer MaxHeight="300"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto">
        <TextBox x:Name="CodeTextBox"
                 Classes="tool-code-viewer"
                 Text="{Binding Text, RelativeSource={RelativeSource AncestorType=controls:ReadOnlyCodeBlock}}"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 TextWrapping="NoWrap"
                 BorderThickness="0"
                 Background="Transparent"
                 IsTabStop="False" />
    </ScrollViewer>
</UserControl>
